#[doc("""
Drawing an image on a terminal that can: asking whether it can, and
building the escape sequence that does it.

Two protocols are spoken. **kitty** is asked rather than assumed — it
defines a query whose answer is the capability itself, and a terminal
that does not speak it stays silent. **iTerm2** defines no query, so it
is recognised from the environment, which is weaker and says so.

`detect` is the only part that touches a terminal. `sequence` is pure:
bytes in, escape sequence out, testable without one.
""")]

import array
import bin
import math.int
import encoding.base64
import os.env
import terevaka.term as term

#[doc("""
What the terminal will accept, and how.

`Placed` is the good one: kitty, and a terminal that told us how many
pixels a cell is, so an image can be given a virtual placement and shown
through placeholder characters that occupy real cells. Those measure and
scroll like any other text, which is what lets a picture live inside the
pager.

`Kitty` is the same protocol without that measurement, so the image can
only be drawn where the cursor stands — no placement, and nothing the
pager could page. `Iterm` is always that, having no placement mechanism
at all.

`NoImages` is both "it cannot" and "we were told not to ask": from the
caller's side they are the same answer.
""")]
#[derive(Eq, Show)]
pub type Protocol = Placed(Int, Int) | Kitty | Iterm | NoImages

#[doc("""
Asks the terminal what it can draw, honouring `want`: `"never"` does
not ask at all, `"kitty"` and `"iterm"` say it without asking, and
`"auto"` queries for kitty and then falls back to recognising iTerm2
from the environment.

The query goes out only when both descriptors are terminals. With
stdout redirected there is nobody to answer and the request would land
in the output as stray bytes, which is a corruption that survives into
whatever file was being written.
""")]
pub fn detect(want: String) : Protocol / Ffi + Env + Stdout + Stdin = match want {
  "never" -> NoImages
  "none" -> NoImages
  "kitty" -> Kitty
  "iterm" -> Iterm
  _ ->
    if not (Stdout.is_tty() and Stdin.is_tty()) {
      NoImages
    } else if speaks_kitty() {
      Kitty
    } else if looks_like_iterm() {
      Iterm
    } else {
      NoImages
    }
}

# kitty's capability query: a one-pixel transmission it is asked to
# report on rather than draw. A terminal that implements the protocol
# answers `OK`; one that does not answers nothing, and `probe` returns
# `None` after its budget rather than hanging.
fn speaks_kitty() : Bool / Ffi = match term.probe(
  "#{esc()}_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA#{esc()}\\",
  [st(), bel()],
  250
) {
  Some(reply) -> char_index_of(reply, "OK") != None
  None -> false
}

# iTerm2 ships no query, so this is the environment or nothing.
# `LC_TERMINAL` is the one that survives ssh, since iTerm2 forwards it
# on purpose; `TERM_PROGRAM` is local only.
fn looks_like_iterm() : Bool / Env =
  env.get("LC_TERMINAL").unwrap_or("") == "iTerm2"
    or env.get("TERM_PROGRAM").unwrap_or("") == "iTerm.app"

#[doc("""
The escape sequence that draws `bytes`, or `None` for a protocol that
draws nothing. Pure — the bytes were read by the caller.

kitty takes the payload in chunks, because its own protocol caps an
escape sequence at 4096 base64 characters; every chunk but the last
says another follows. iTerm2 takes it whole and wants the decoded
length, which is what it sizes the drawing from.
""")]
pub fn sequence(proto: Protocol, buf: Array[Byte]) : Option[String] = match proto {
  NoImages -> None
  # A placed image is not drawn by anything in the text. It is transmitted
  # once, given a placement, and shown by the placeholders `grid` builds.
  Placed(_, _) -> None
  Iterm -> {
    let bytes = payload(buf)
    Some("#{esc()}]1337;File=inline=1;size=#{bytes.length()}:#{base64.encode(bytes)}#{bel()}")
  }
  # kitty takes PNG or raw pixels. Handing it anything else under `f=100`
  # is a lie the terminal cannot catch and the reader sees as nothing at
  # all, so it is refused here and the caller converts or falls back.
  Kitty ->
    if format_of(buf) != Png {
      None
    } else {
      Some(string.join(kitty_chunks(chunk(payload(buf)), true, []), ""))
    }
}

# `Byte` is its own type and the encoder wants `Int`, so every byte is
# read back out of the buffer by index — `bin.get_uint_be` over one byte
# is the accessor the stdlib gives for exactly this.
fn payload(buf: Array[Byte]) : [Int] =
  enumerate(array.to_list(buf)) | (p => bin.get_uint_be(buf, p.fst, 1).unwrap_or(0))

# The protocol caps an escape sequence at 4096 base64 characters, which
# is exactly what 3072 bytes encode to. Cutting the bytes rather than the
# encoded string is what keeps this linear: slicing a multi-megabyte
# String once per chunk copies its whole tail every time, and a 3.5 MB
# image turns two seconds of work into two minutes of it.
fn chunk(bytes: [Int]) : [String] = list.chunk(bytes, 3072) | base64.encode

# Only the first chunk carries the format and the order to display;
# every one says whether another follows, and the last says it does not.
fn kitty_chunks(cs: [String], first: Bool, acc: [String]) : [String] = match cs {
  [] -> reverse(acc)
  [c] -> reverse(["#{esc()}_G#{if first { "a=T,f=100," } else { "" }}m=0;#{c}#{st()}", ...acc])
  [c, ...t] ->
    kitty_chunks(t, false, [
      "#{esc()}_G#{if first { "a=T,f=100," } else { "" }}m=1;#{c}#{st()}",
      ...acc
    ])
}

fn esc() : String = "\u{1b}"

# The two ways a terminal closes an answer: ST, and the older BEL.
fn st() : String = "#{esc()}\\"

fn bel() : String = "\u{7}"

# ---- Unicode placeholders ----

#[doc("""
The size of one terminal cell in pixels, as `(width, height)`.

`CSI 16 t` is the question and `CSI 6 ; height ; width t` the answer. It
is what turns an image's pixels into rows and columns, and a terminal
that will not say leaves images drawable only where the cursor stands.
""")]
pub fn cell_size() : Option[(Int, Int)] / Ffi = match term.probe("#{esc()}[16t", ["t"], 300) {
  None -> None
  Some(reply) -> {
    let parts = string.split(string.replace(reply, "#{esc()}[", ""), ";")
    match (to_int(nth(parts, 1).unwrap_or("")), to_int(nth(parts, 2).unwrap_or(""))) {
      (Some(h), Some(w)) -> if w > 0 and h > 0 { Some((w, h)) } else { None }
      _ -> None
    }
  }
}

#[doc("""
A PNG's pixel size, read from the IHDR header it opens with: width then
height, big-endian, at bytes 16 and 20. Anything else reads as `None`,
which is the honest answer for a format whose size we cannot find.
""")]
pub fn png_size(buf: Array[Byte]) : Option[(Int, Int)] =
  match (bin.get_uint_be(buf, 16, 4), bin.get_uint_be(buf, 20, 4)) {
    (Some(w), Some(h)) -> if w > 0 and h > 0 { Some((w, h)) } else { None }
    _ -> None
  }

#[doc("""
How many columns and rows an image of `w` by `h` pixels covers in cells
of `cw` by `ch`. Rounded up, so the picture is never cut by the grid
that holds it.
""")]
pub fn cells_for(w: Int, h: Int, cw: Int, ch: Int) : (Int, Int) =
  (int.max((w + cw - 1) / cw, 1), int.max((h + ch - 1) / ch, 1))

#[doc("""
Sends the image to the terminal and gives it a virtual placement, under
`id`. Nothing is drawn: this is the transmission the placeholders then
refer to, which is why it happens once, before any output, and survives
a screen the pager clears.

`q=2` silences the terminal's acknowledgements. They would arrive on
stdin and the pager would read them as keystrokes.
""")]
pub fn install(id: Int, buf: Array[Byte], cols: Int, rows: Int) : Unit / Ffi {
  let cs = chunk(payload(buf))
  foreach(
    enumerate(cs),
    p => term.write(
      "#{esc()}_G#{if p.fst == 0 { "a=t,f=100,t=d,q=2,i=#{id}," } else { "" }}m=#{if p.fst == cs.length() - 1 { 0 } else { 1 }};#{p.snd}#{st()}"
    )
  )
  term.write("#{esc()}_Ga=p,U=1,q=2,i=#{id},c=#{cols},r=#{rows}#{st()}")
}

#[doc("""
The lines that show image `id`: a `rows` by `cols` block of placeholder
characters, each line a string the renderer and the pager treat as
ordinary text — `text.display_width` counts one column per cell and
none for the diacritics, so it wraps, scrolls and clips like prose.

Only the first cell of a line carries a diacritic, the row number. The
rest inherit it from the neighbour on their left and count their own
columns, which is the protocol's own rule and keeps the line short.
""")]
pub fn grid(id: Int, cols: Int, rows: Int) : [String] =
  [0..(rows - 1)] | (r => grid_row(id, r, cols))

fn grid_row(id: Int, row: Int, cols: Int) : String {
  # The image id rides in the foreground colour, which is why the run has
  # to be closed again: the cells after it are text.
  let fg = "#{esc()}[38;2;#{id / 65536 % 256};#{id / 256 % 256};#{id % 256}m"
  let first = "#{PLACEHOLDER}#{from_chars([int_to_char(nth(diacritics(), row).unwrap_or(0x0305))])}"
  "#{fg}#{first}#{repeat(PLACEHOLDER, int.max(cols - 1, 0))}#{esc()}[39m"
}

#[doc("The cell a placed image is shown through.")]
pub const PLACEHOLDER : String = "\u{10EEEE}"

#[doc("""
How many rows an image may be given a placement over: one diacritic per
row, and the table has this many.
""")]
pub fn max_rows() : Int = diacritics().length()

# kitty's rowcolumn-diacritics table, verbatim: the combining character
# at index n is the one that means "n". Taken from the file kitty derives
# from UnicodeData.txt, not from memory.
fn diacritics() : [Int] = [
  0x0305, 0x030D, 0x030E, 0x0310, 0x0312, 0x033D, 0x033E, 0x033F,
  0x0346, 0x034A, 0x034B, 0x034C, 0x0350, 0x0351, 0x0352, 0x0357,
  0x035B, 0x0363, 0x0364, 0x0365, 0x0366, 0x0367, 0x0368, 0x0369,
  0x036A, 0x036B, 0x036C, 0x036D, 0x036E, 0x036F, 0x0483, 0x0484,
  0x0485, 0x0486, 0x0487, 0x0592, 0x0593, 0x0594, 0x0595, 0x0597,
  0x0598, 0x0599, 0x059C, 0x059D, 0x059E, 0x059F, 0x05A0, 0x05A1,
  0x05A8, 0x05A9, 0x05AB, 0x05AC, 0x05AF, 0x05C4, 0x0610, 0x0611,
  0x0612, 0x0613, 0x0614, 0x0615, 0x0616, 0x0617, 0x0657, 0x0658,
  0x0659, 0x065A, 0x065B, 0x065D, 0x065E, 0x06D6, 0x06D7, 0x06D8,
  0x06D9, 0x06DA, 0x06DB, 0x06DC, 0x06DF, 0x06E0, 0x06E1, 0x06E2,
  0x06E4, 0x06E7, 0x06E8, 0x06EB, 0x06EC, 0x0730, 0x0732, 0x0733,
  0x0735, 0x0736, 0x073A, 0x073D, 0x073F, 0x0740, 0x0741, 0x0743,
  0x0745, 0x0747, 0x0749, 0x074A, 0x07EB, 0x07EC, 0x07ED, 0x07EE,
  0x07EF, 0x07F0, 0x07F1, 0x07F3, 0x0816, 0x0817, 0x0818, 0x0819,
  0x081B, 0x081C, 0x081D, 0x081E, 0x081F, 0x0820, 0x0821, 0x0822,
  0x0823, 0x0825, 0x0826, 0x0827, 0x0829, 0x082A, 0x082B, 0x082C,
  0x082D, 0x0951, 0x0953, 0x0954, 0x0F82, 0x0F83, 0x0F86, 0x0F87,
  0x135D, 0x135E, 0x135F, 0x17DD, 0x193A, 0x1A17, 0x1A75, 0x1A76,
  0x1A77, 0x1A78, 0x1A79, 0x1A7A, 0x1A7B, 0x1A7C, 0x1B6B, 0x1B6D,
  0x1B6E, 0x1B6F, 0x1B70, 0x1B71, 0x1B72, 0x1B73, 0x1CD0, 0x1CD1,
  0x1CD2, 0x1CDA, 0x1CDB, 0x1CE0, 0x1DC0, 0x1DC1, 0x1DC3, 0x1DC4,
  0x1DC5, 0x1DC6, 0x1DC7, 0x1DC8, 0x1DC9, 0x1DCB, 0x1DCC, 0x1DD1,
  0x1DD2, 0x1DD3, 0x1DD4, 0x1DD5, 0x1DD6, 0x1DD7, 0x1DD8, 0x1DD9,
  0x1DDA, 0x1DDB, 0x1DDC, 0x1DDD, 0x1DDE, 0x1DDF, 0x1DE0, 0x1DE1,
  0x1DE2, 0x1DE3, 0x1DE4, 0x1DE5, 0x1DE6, 0x1DFE, 0x20D0, 0x20D1,
  0x20D4, 0x20D5, 0x20D6, 0x20D7, 0x20DB, 0x20DC, 0x20E1, 0x20E7,
  0x20E9, 0x20F0, 0x2CEF, 0x2CF0, 0x2CF1, 0x2DE0, 0x2DE1, 0x2DE2,
  0x2DE3, 0x2DE4, 0x2DE5, 0x2DE6, 0x2DE7, 0x2DE8, 0x2DE9, 0x2DEA,
  0x2DEB, 0x2DEC, 0x2DED, 0x2DEE, 0x2DEF, 0x2DF0, 0x2DF1, 0x2DF2,
  0x2DF3, 0x2DF4, 0x2DF5, 0x2DF6, 0x2DF7, 0x2DF8, 0x2DF9, 0x2DFA,
  0x2DFB, 0x2DFC, 0x2DFD, 0x2DFE, 0x2DFF, 0xA66F, 0xA67C, 0xA67D,
