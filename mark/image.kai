#[doc("""
Several pictures laid out side by side, as the lines that show them.

Each tile is the lines of one picture and how many columns it covers.
Tiles are packed left to right while they fit in `width` and then begin
a new band, so a row of pictures wraps the way a row of words does
rather than running off the edge — which, in the pager, would be a
frame painted wider than the terminal.

Inside a band the tiles are joined column by column, and one shorter
than its neighbours is padded with blanks so the band stays
rectangular. Pure: the tiles were built by `grid`.
""")]
pub fn bands(tiles: [([String], Int)], width: Int) : [String] =
  pack(tiles, width, [], [])

fn pack(ts: [([String], Int)], width: Int, cur: [([String], Int)], out: [[String]]) : [String] =
  match ts {
    [] -> join_all(reverse(if cur.is_empty() { out } else { [merge(reverse(cur)), ...out] }))
    [t, ...rest] ->
      if cur.is_empty() or band_width(cur) + 1 + t.snd <= width {
        pack(rest, width, [t, ...cur], out)
      } else {
        pack(rest, width, [t], [merge(reverse(cur)), ...out])
      }
  }

fn join_all(bs: [[String]]) : [String] = bs || (b => b)

fn band_width(cur: [([String], Int)]) : Int = sum(cur | (t => t.snd)) + cur.length() - 1

# One band: as tall as its tallest tile, every tile padded out to its own
# width so the columns of the next one start where they should.
fn merge(cur: [([String], Int)]) : [String] {
  let h = max_of(cur | (t => list.length(t.fst)))
  [0..(h - 1)] | (r => string.join(cur | (t => line_at(t, r)), " "))
}

fn line_at(t: ([String], Int), r: Int) : String =
  nth(t.fst, r).unwrap_or(repeat(" ", t.snd))

fn max_of(xs: [Int]) : Int = foldl(xs, 0, int.max)

# ---- Formats ----

#[doc("""
The image formats a document is likely to name, told apart by the bytes
they open with rather than by the extension — a name is a claim and a
magic number is evidence.

Only `Png` can be transmitted to kitty, which accepts PNG or raw pixels
and nothing else; the rest have to be converted first. iTerm2 takes
whatever the system can open, so there the distinction does not matter.
""")]
#[derive(Eq, Show)]
pub type Format = Png | Jpeg | Gif | Webp | Bmp | Other

#[doc("What `buf` holds, judged by the bytes it starts with.")]
pub fn format_of(buf: Array[Byte]) : Format =
  if opens_with(buf, [137, 80, 78, 71, 13, 10, 26, 10]) {
    Png
  } else if opens_with(buf, [255, 216, 255]) {
    Jpeg
  } else if opens_with(buf, [71, 73, 70, 56]) {
    Gif
  } else if opens_with(buf, [82, 73, 70, 70]) and at(buf, 8, 4) == [87, 69, 66, 80] {
    Webp
  } else if opens_with(buf, [66, 77]) {
    Bmp
  } else {
    Other
  }

fn opens_with(buf: Array[Byte], magic: [Int]) : Bool = at(buf, 0, magic.length()) == magic

# The `n` bytes at `from`, or a short list at the end of the buffer —
# which never equals a magic number and so reads as "not this format".
fn at(buf: Array[Byte], from: Int, n: Int) : [Int] =
  [from..(from + n - 1)]
    || (i => match bin.get_uint_be(buf, i, 1) {
      Some(b) -> [b]
      None -> []
    })

#[doc("""
Sends the image by naming the file instead of spelling out its bytes,
and gives it the same virtual placement `install` does.

This is the fast path and by a wide margin: the payload is the path, so
nothing is read byte by byte, nothing is base64-encoded and nothing is
chunked. A 3.5 MB picture costs what a small one costs.

It needs the terminal to share this filesystem, which rules out ssh —
the caller decides that. `temp` says the file was made for this and the
terminal may delete it once read, which kitty only honours for a path
carrying `tty-graphics-protocol` in it.
""")]
pub fn install_path(id: Int, file: String, cols: Int, rows: Int, temp: Bool) : Unit / Ffi {
  let medium = if temp { "t" } else { "f" }
  term.write(
    "#{esc()}_Ga=t,f=100,t=#{medium},q=2,i=#{id};#{base64.encode(path_bytes(file))}#{st()}"
  )
  term.write("#{esc()}_Ga=p,U=1,q=2,i=#{id},c=#{cols},r=#{rows}#{st()}")
}

# A path is short, so the byte-by-byte walk that would be ruinous over an
# image costs nothing here.
fn path_bytes(file: String) : [Int] = payload(array.from(string.bytes(file)))

#[doc("""
The infix kitty requires in the path of a file it is asked to delete,
its own guard against being told to unlink something that matters.
""")]
pub const TEMP_MARK : String = "tty-graphics-protocol"

#[doc("""
The sequence that draws `file` where the cursor stands, by naming it
rather than spelling it out — the same saving `install_path` makes, for
a terminal that reports no cell size and so gets no placement.

`None` for iTerm2, whose protocol carries the data and offers no way to
point at a file, and for anything that draws nothing.
""")]
pub fn sequence_path(proto: Protocol, file: String, temp: Bool) : Option[String] = match proto {
  Kitty ->
    Some(
      "#{esc()}_Ga=T,f=100,t=#{if temp { "t" } else { "f" }},q=2;#{base64.encode(path_bytes(file))}#{st()}"
    )
  _ -> None
}
