#[doc("""
From `[Block]` to ANSI lines, at a given width. Pure.

The decision that orders this module: **wrap before painting**. An ANSI
code occupies no columns, so measuring already-coloured text overcounts.
Text travels as `[Cell]` — a codepoint with the style that applies to
it — is cut into words measuring only the codepoints with
`text.display_width`, and only the final pass emits the sequences.

Accumulators grow at the FRONT and are reversed once. `acc ++ [x]` in a
loop copies the accumulator every step, which makes rendering quadratic
in the length of a paragraph rather than linear.
""")]

import text
import math.int
import mark.ast
import mark.theme

#[doc("Smallest usable width; below it, wrapping buys nothing.")]
pub fn min_width() : Int = 20

#[doc("Renders the document to lines ready to be written out.")]
pub fn render(th: theme.Theme, width: Int, bs: [ast.Block]) : [String] =
  reverse(blocks(th, int.max(width, min_width()), bs, []))

# The cell a hard break travels as. A newline occupies no column and
# cannot occur in a line otherwise, so it needs no escaping of its own.
const BREAK : Char = '\n'

# A codepoint with its style: the intermediate representation that
# allows measuring without counting the ANSI codes.
type Cell = { ch: Char, style: String }

# `acc` runs backwards, newest line first; `render` puts it back.
fn blocks(th: theme.Theme, width: Int, bs: [ast.Block], acc: [String]) : [String] =
  match bs {
    [] -> acc
    [b, ...rest] -> {
      let ls = block(th, width, b)
      let sep = if acc.is_empty() or ls.is_empty() { [] } else { [""] }
      blocks(th, width, rest, reverse(ls) ++ sep ++ acc)
    }
  }

fn block(th: theme.Theme, width: Int, b: ast.Block) : [String] = match b {
  Rule -> [paint_all(th.rule, repeat("─", width), th.reset)]
  # The level travels as the source `#`: it survives copy-paste and does
  # not depend on the terminal telling the shades apart.
  Heading(n, xs) ->
    lay(th, width, repeat("#", n) ++ " ", th.heading, styled(th, xs, th.heading))
  Para(xs) -> lay(th, width, "", "", styled(th, xs, ""))
  # A fence body is literal: it gets indented but never wrapped, because
  # breaking a line of code changes what it says.
  Code(_, ls) -> ls | (l => paint_all(th.code, "  " ++ l, th.reset))
  Quote(inner) ->
    indent(paint_all(th.quote, "│ ", th.reset), 2, block_list(th, width - 2, inner))
  Bullets(items) -> items || (it => list_item(th, width, "• ", it))
  Ordered(start, items) -> enumerate(items)
    || (p => list_item(th, width, "#{start + p.fst}. ", p.snd))
  Table(head, aligns, body) -> table(th, width, head, aligns, body)
  # The sequence draws itself and leaves the cursor below: it occupies no
  # columns, so it never goes through the wrap. The alt text is not shown
  # beside it — the picture is there, and saying what it is twice is
  # what the alt text exists to avoid.
  Picture(seq, _) -> [seq]
}

# ---- Tables ----

# A table is laid out in two passes: the columns are sized from what
# every cell needs, then each cell is wrapped to the width its column
# actually got. Wrapping rather than truncating is the same rule the
# rest of the renderer follows — the width is a constraint on the
# layout, never a licence to drop text.
fn table(
  th: theme.Theme,
  width: Int,
  head: [[ast.Inline]],
  aligns: [ast.Align],
  body: [[[ast.Inline]]]
) : [String] {
  let head_cells = head | (c => styled(th, c, th.strong))
  let body_cells = body | (r => styled_row(th, r))
  let cols = fit_cols(natural(head_cells, body_cells), width - frame_width(aligns.length()))
  let bar = (l, mid, r) => paint_all(th.rule, edge(l, mid, r, cols), th.reset)
  [bar("┌", "┬", "┐")]
    ++ row(th, head_cells, cols, aligns)
    ++ [bar("├", "┼", "┤")]
    ++ (body_cells || (r => row(th, r, cols, aligns)))
    ++ [bar("└", "┴", "┘")]
}

# What the frame itself costs: a bar between every pair of columns and
# at both ends, plus the space padding each cell.
fn frame_width(n: Int) : Int = 3 * n + 1

# The width each column would take if nothing constrained it.
fn natural(head: [[Cell]], body: [[[Cell]]]) : [Int] =
  enumerate(head) | (p => int.max(cells_width(p.snd), col_width(body, p.fst)))

fn col_width(body: [[[Cell]]], i: Int) : Int =
  max_of(body | (r => cells_width(nth_line(r, i))))

# Over budget the columns are trimmed to a common ceiling rather than
# in proportion to what each asked for. A narrow column that already
# fitted keeps its width, and only the ones above the ceiling give
# anything up: cutting proportionally would shave `Module` down to five
# columns to pay for a long neighbour that is still too long anyway.
fn fit_cols(nat: [Int], avail: Int) : [Int] =
  if sum(nat) <= avail or avail <= 0 {
    nat
  } else {
    nat | (w => int.max(int.min(w, ceiling(nat, avail, 1, 1)), 1))
  }

# The highest ceiling under which every column, trimmed to it, still
# fits the budget.
fn ceiling(nat: [Int], avail: Int, c: Int, best: Int) : Int =
  if c > max_of(nat) {
    best
  } else if capped(nat, c) <= avail {
    ceiling(nat, avail, c + 1, c)
  } else {
    best
  }

fn capped(nat: [Int], c: Int) : Int = sum(nat | (w => int.min(w, c)))

# One source row, which is as many output lines as its tallest cell:
# the others are padded with blanks so the frame stays rectangular.
fn row(th: theme.Theme, cells: [[Cell]], cols: [Int], aligns: [ast.Align]) : [String] {
  let wrapped = zip(cells, cols) | (p => wrap_cell(p.fst, p.snd))
  let bar = paint_all(th.rule, "│", th.reset)
  [0..(max_of(wrapped | (.length())) - 1)]
    | (i => bar ++ row_line(th, wrapped, cols, aligns, bar, i))
}

fn styled_row(th: theme.Theme, r: [[ast.Inline]]) : [[Cell]] = r | (c => styled(th, c, ""))

# `wrap` lets a word wider than the margin out whole rather than
# splitting it, which is right for a paragraph and wrong here: one long
# word would reach past its bar and break the grid. Inside a cell the
# word is cut instead — every character is kept, on the next line.
fn wrap_cell(cs: [Cell], w: Int) : [[Cell]] {
  let col = int.max(w, 1)
  wrap(cs, col, empty_run(), empty_run(), []) || (l => chop(l, col, []))
}

fn chop(l: [Cell], w: Int, acc: [[Cell]]) : [[Cell]] =
  if cells_width(l) <= w {
    reverse([l, ...acc])
  } else {
    let n = int.max(fits_in(l, w, 0, 0), 1)
    chop(drop(l, n), w, [take(l, n), ...acc])
  }

# How many leading cells fit in `w` columns. A double-width character
# goes to the next line whole rather than being halved.
fn fits_in(cs: [Cell], w: Int, n: Int, used: Int) : Int = match cs {
  [] -> n
  [c, ...t] -> {
    let cw = text.char_width(char_to_int(c.ch))
    if used + cw > w { n } else { fits_in(t, w, n + 1, used + cw) }
  }
}

# One output line across every column, each cell padded to its width and
# closed by the bar that separates it from the next.
fn row_line(
  th: theme.Theme,
  wrapped: [[[Cell]]],
  cols: [Int],
  aligns: [ast.Align],
  bar: String,
  i: Int
) : String =
  join(
    zip3(wrapped, cols, aligns)
      | (t => " #{pad_to(th, nth_line(t.fst, i), t.snd, t.trd)} #{bar}"),
    ""
  )

fn nth_line(lines: [[Cell]], i: Int) : [Cell] = nth(lines, i).unwrap_or([])

# The cell painted and then padded out to its column. The padding is
# never painted: a background colour would run past the text the source
# actually marked.
fn pad_to(th: theme.Theme, cs: [Cell], w: Int, a: ast.Align) : String {
  let gap = int.max(w - cells_width(cs), 0)
  let body = paint(cs, th.reset)
  match a {
    AlignLeft -> body ++ repeat(" ", gap)
    AlignRight -> repeat(" ", gap) ++ body
    AlignCenter -> repeat(" ", gap / 2) ++ body ++ repeat(" ", gap - gap / 2)
  }
}

fn edge(l: String, mid: String, r: String, cols: [Int]) : String =
  l ++ join(cols | (w => repeat("─", w + 2)), mid) ++ r

fn cells_width(cs: [Cell]) : Int =
  sum(cs | (c => text.char_width(char_to_int(c.ch))))

fn max_of(xs: [Int]) : Int = list.max(xs).unwrap_or(0)

# The inner floor is about columns, not legibility: `min_width` governs
# the width the CLI asks for, but a nested container only needs to be
# guaranteed somewhere to write.
fn block_list(th: theme.Theme, width: Int, bs: [ast.Block]) : [String] =
  reverse(blocks(th, int.max(width, 4), bs, []))

# A list item: the marker only on the first line, the rest aligned to
# the column where its text starts. A task item carries its box after
# the marker, so the bullets of a mixed list still line up.
fn list_item(th: theme.Theme, width: Int, marker: String, it: ast.Item) : [String] {
  let lead = marker ++ task_box(it.task)
  let pad = text.display_width(lead)
  indent_first(
    paint_all(th.marker, lead, th.reset),
    repeat(" ", pad),
    block_list(th, width - pad, it.blocks)
  )
}

fn task_box(task: Option[Bool]) : String = match task {
  None -> ""
  Some(true) -> "[x] "
  Some(false) -> "[ ] "
}

# Wraps the cells and puts the prefix on the first line; the following
# ones line up with its column.
fn lay(
  th: theme.Theme,
  width: Int,
  first: String,
  prefix_style: String,
  cs: [Cell]
) : [String] {
  let pad = text.display_width(first)
  let lines =
    wrap(cs, int.max(width - pad, 4), empty_run(), empty_run(), []) | (l => paint(l, th.reset))
  indent(paint_all(prefix_style, first, th.reset), pad, lines)
}

fn indent(prefix: String, pad: Int, ls: [String]) : [String] =
  indent_first(prefix, repeat(" ", pad), ls)

fn indent_first(first: String, rest: String, ls: [String]) : [String] =
  enumerate(ls) | (p => if p.fst == 0 { first ++ p.snd } else { rest ++ p.snd })

# ---- Flattening the inline tree ----

# Each node contributes its style to its container's; the result is a
# flat run of cells, with no nesting left to reconstruct when painting.
fn styled(th: theme.Theme, xs: [ast.Inline], base: String) : [Cell] =
  xs
    || (x => match x {
      Text(s) -> cells(s, base)
      Emph(inner) -> styled(th, inner, base ++ th.emph)
      Strong(inner) -> styled(th, inner, base ++ th.strong)
      Strike(inner) -> styled(th, inner, base ++ th.strike)
      CodeSpan(s) -> cells(s, base ++ th.code)
      # The destination rides along with the label in parentheses: with no
      # terminal hyperlink, an invisible URL is a lost URL. Unless the
      # label already is the URL, as in an autolink — then printing it
      # twice is the only thing the parentheses would add.
      Link(label, dest) ->
        styled(th, label, base ++ th.link)
          ++ (if shows_dest(label, dest) { cells(" (#{dest})", base ++ th.url) } else { [] })
      # A hard break travels as a newline cell; `wrap` is what turns it
      # into a line, since only it knows where the line was.
      Break -> [Cell { ch: BREAK, style: "" }]
      # `parser.parse` resolves every reference; one reaching here came
      # from an AST built by hand, and its label is still the text.
      Ref(label, _) -> styled(th, label, base)
      # An image the terminal could not draw, or that shares a line with
      # text. Its alt text is what a reader is left with, so it is marked
      # as a picture and keeps its source.
      Image(label, src) ->
        cells("[", base ++ th.marker)
          ++ styled(th, label, base ++ th.marker)
          ++ cells("]", base ++ th.marker)
          ++ cells(" (#{src})", base ++ th.url)
      ImageRef(label, _) -> styled(th, label, base)
    })

fn cells(s: String, style: String) : [Cell] =
  chars(s) | (c => Cell { ch: c, style: style })

# ---- Wrapping ----

# A line and its width, carried together. Measuring the line again for
# every word placed on it re-walks what is already known — with a dozen
# words per line that is an order of magnitude of wasted work.
type Run = { cells: [Cell], width: Int }

fn empty_run() : Run = Run { cells: [], width: 0 }

# Gathers a word up to the next space and places it on the line in
# progress; a word wider than the margin is let out rather than split.
#
# `line`, `word` and `acc` all run backwards while they are built.
fn wrap(cs: [Cell], width: Int, line: Run, word: Run, acc: [[Cell]]) : [[Cell]] =
  match cs {
    [] -> {
      let (done, pending) = place(acc, line, word, width)
      reverse(
        if pending.cells.is_empty() { done } else { [reverse(pending.cells), ...done] }
      )
    }
    [c, ...t] ->
      if c.ch == BREAK {
        # The source asked for this line to end here. Whatever is in hand
        # closes it, and the next word starts a line of its own.
        let (done, current) = place(acc, line, word, width)
        wrap(t, width, empty_run(), empty_run(), [reverse(current.cells), ...done])
      } else if c.ch == ' ' {
        let (done, current) = place(acc, line, word, width)
        wrap(t, width, current, empty_run(), done)
      } else {
        wrap(t, width, line, grow(word, c), acc)
      }
  }

fn grow(r: Run, c: Cell) : Run =
  Run { cells: [c, ...r.cells], width: r.width + text.char_width(char_to_int(c.ch)) }

fn place(acc: [[Cell]], line: Run, word: Run, width: Int) : ([[Cell]], Run) =
  if word.cells.is_empty() {
    (acc, line)
  } else if line.cells.is_empty() {
    (acc, word)
  } else if line.width + 1 + word.width <= width {
    let sep = Cell { ch: ' ', style: joint_style(line.cells, word.cells) }
    (acc, Run { cells: word.cells ++ [sep] ++ line.cells, width: line.width + 1 + word.width })
  } else {
    ([reverse(line.cells), ...acc], word)
  }

# The space between two words of the same style joins them, so the run
# is not closed and reopened at every word. When the style changes it
# stays neutral: painting it would extend the colour one column past
# what the source marked.
#
# Both lists run backwards: the line's last cell is its head, and the
# word's first cell is its last.
fn joint_style(line: [Cell], word: [Cell]) : String {
  let before = head(line).map(.style).unwrap_or("")
  let after = last(word).map(.style).unwrap_or("")
  if before == after { before } else { "" }
}

# ---- Painting ----

# Emits a code only when the style changes, closing with `reset` before
# each change so attributes do not accumulate.
fn paint(cs: [Cell], rst: String) : String =
  join(reverse(runs(cs, "", [], [], rst)), "")

# Gathers consecutive cells sharing a style into one run: that is one
# `from_chars` and one pair of codes per run, rather than a fresh String
# allocated for every single character.
fn runs(cs: [Cell], cur: String, buf: [Char], out: [String], rst: String) : [String] =
  match cs {
    [] -> emit(cur, buf, out, rst)
    [c, ...t] ->
      if c.style == cur {
        runs(t, cur, [c.ch, ...buf], out, rst)
      } else {
        runs(t, c.style, [c.ch], emit(cur, buf, out, rst), rst)
      }
  }

# `out` runs backwards, so a run is pushed as (reset, body, style).
fn emit(style: String, buf: [Char], out: [String], rst: String) : [String] =
  if buf.is_empty() {
    out
  } else {
    let body = from_chars(reverse(buf))
    if style == "" { [body, ...out] } else { [rst, body, style, ...out] }
  }

fn paint_all(style: String, s: String, rst: String) : String =
  if style == "" or s == "" { s } else { style ++ s ++ rst }

# An autolink is its own destination, and `<a@b>` only gained the scheme
# a terminal could not infer for it. Either way the parentheses would
# repeat the label word for word.
fn shows_dest(label: [ast.Inline], dest: String) : Bool = match label {
  [ast.Text(s)] -> s != dest and "mailto:#{s}" != dest
  _ -> true
}
