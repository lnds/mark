#[doc("""
Block parser: from source text to `[Block]`. Pure and effect-free, so
it can be tested by structural equality against the AST.

The walk is line by line: each block shape is recognised by the prefix
of its first line, consumes the lines belonging to it, and returns the
rest. Containers (quote, list item) re-enter `blocks` with their lines
already de-indented, so nesting falls out of the recursion instead of a
special case per level.
""")]

import mark.ast
import mark.inline

# What a recogniser returns: the block, and the lines still unconsumed.
type Parsed = (ast.Block, [String])

# A label and the destination its definition gave it. A document holds a
# handful of these, so a list walked linearly beats a map that would have
# to be built and imported for it.
type Defs = [(String, String)]

#[doc("""
Parses a whole markdown document.

Three passes, in the order the format forces: the front matter is not
markdown and comes off first; the link reference definitions are
gathered next, because `[text][label]` may precede the `[label]:` line
that explains it; and only then do the blocks get read and their
references settled.
""")]
pub fn parse(src: String) : [ast.Block] {
  let (defs, body) = take_definitions(strip_front_matter(lines(src)), [], [], false)
  blocks(body) | (b => resolve_block(defs, b))
}

# ---- Front matter ----

# A fence on the very first line opens a metadata block that is not
# markdown: `---` for YAML, `+++` for TOML — Hugo writes the second and
# a `+++` block is not even a rule, so unstripped it reads as a
# paragraph of settings. Without a closing fence there was no front
# matter at all, and `---` goes back to being the rule it looks like.
fn strip_front_matter(ls: [String]) : [String] = match ls {
  [first, ...rest] -> match opener(trim(first)) {
    None -> ls
    Some(closers) -> match index_of(rest, l => contains(closers, trim(l))) {
      Some(i) -> drop(rest, i + 1)
      None -> ls
    }
  }
  [] -> ls
}

# What may close the block this line opened. YAML allows `...` as well
# as a second `---`; TOML closes only with its own fence.
fn opener(l: String) : Option[[String]] =
  if l == "---" {
    Some(["---", "..."])
  } else if l == "+++" {
    Some(["+++"])
  } else {
    None
  }

# ---- Link reference definitions ----

# `[label]: destination` is not content: it explains a reference that may
# be anywhere in the document. The line is blanked rather than removed,
# so the blocks around it stay as separated as the source left them, and
# a fence is tracked because inside one the same text is code.
fn take_definitions(ls: [String], defs: Defs, out: [String], fenced: Bool) : (Defs, [String]) =
  match ls {
    [] -> (reverse(defs), reverse(out))
    [l, ...t] -> {
      let fence = fence_marker(l) != None
      match if fenced or fence { None } else { definition(l) } {
        Some(d) -> take_definitions(t, [d, ...defs], ["", ...out], fenced)
        None -> take_definitions(t, defs, [l, ...out], if fence { not fenced } else { fenced })
      }
    }
  }

fn definition(l: String) : Option[(String, String)] {
  let t = trim(l)
  if not starts_with(t, "[") {
    None
  } else {
    match char_index_of(t, "]:") {
      None -> None
      Some(i) -> {
        let label = slice(t, 1, i - 1)
        let rest = trim(slice(t, i + 2, chars(t).length() - i - 2))
        if is_empty(trim(label)) or is_empty(rest) {
          None
        } else {
          Some((inline.fold_label(label), first_word(rest)))
        }
      }
    }
  }
}

# The destination runs to the first space; a title may follow it, and it
# says nothing the label has not said already.
fn first_word(s: String) : String = match char_index_of(s, " ") {
  Some(i) -> slice(s, 0, i)
  None -> s
}

# ---- Resolving references ----

# `Ref` is the scanner admitting it could not know yet. Here every
# definition has been read, so each one becomes the link it meant — or,
# with nothing to match, the literal brackets the source typed.
fn resolve_block(defs: Defs, b: ast.Block) : ast.Block = match b {
  Heading(n, xs) -> Heading(n, resolve(defs, xs))
  Para(xs) -> Para(resolve(defs, xs))
  Quote(inner) -> Quote(inner | (x => resolve_block(defs, x)))
  Bullets(items) -> Bullets(items | (it => resolve_item(defs, it)))
  Ordered(n, items) -> Ordered(n, items | (it => resolve_item(defs, it)))
  Table(head, aligns, body) ->
    Table(head | (c => resolve(defs, c)), aligns, body | (r => resolve_row(defs, r)))
  other -> other
}

fn resolve_row(defs: Defs, r: [[ast.Inline]]) : [[ast.Inline]] = r | (c => resolve(defs, c))

fn resolve_item(defs: Defs, it: ast.Item) : ast.Item =
  ast.Item { ...it, blocks: it.blocks | (b => resolve_block(defs, b)) }

fn resolve(defs: Defs, xs: [ast.Inline]) : [ast.Inline] = xs || (x => resolve_one(defs, x))

fn resolve_one(defs: Defs, x: ast.Inline) : [ast.Inline] = match x {
  Ref(label, key) -> match lookup(defs, key) {
    Some(dest) -> [Link(resolve(defs, label), dest)]
    None -> [Text("["), ...resolve(defs, label), Text("]")]
  }
  ImageRef(label, key) -> match lookup(defs, key) {
    Some(src) -> [Image(resolve(defs, label), src)]
    None -> [Text("!["), ...resolve(defs, label), Text("]")]
  }
  Image(label, src) -> [Image(resolve(defs, label), src)]
  Emph(inner) -> [Emph(resolve(defs, inner))]
  Strong(inner) -> [Strong(resolve(defs, inner))]
  Strike(inner) -> [Strike(resolve(defs, inner))]
  Link(label, dest) -> [Link(resolve(defs, label), dest)]
  other -> [other]
}

fn blocks(ls: [String]) : [ast.Block] = match ls {
  [] -> []
  [l, ..._] ->
    if is_blank(l) {
      blocks(drop(ls, 1))
    } else {
      let (block, rest) = block_at(ls)
      [block, ...blocks(rest)]
    }
}

# Precedence is the order of this list, not a chain of `else`: a
# horizontal rule (`---`) reads as a list item (`- `) if tried later,
# and indented code goes first because every other recogniser trims the
# indent away before looking at the line.
# The paragraph closes the list by being the case that accepts anything.
fn block_at(ls: [String]) : Parsed =
  match find_map(
    [
      indented_code_at, rule_at, heading_at, code_at, quote_at,
      bullets_at, ordered_at, table_at
    ],
    recognise => recognise(ls)
  ) {
    Some(parsed) -> parsed
    None -> take_para(ls, [])
  }

fn first_line(ls: [String]) : String = head(ls).unwrap_or("")

# ---- Horizontal rules ----

fn rule_at(ls: [String]) : Option[Parsed] =
  if is_rule(first_line(ls)) { Some((Rule, drop(ls, 1))) } else { None }

# Three or more identical `-`, `*` or `_`, ignoring interleaved spaces.
fn is_rule(l: String) : Bool {
  let cs = chars(trim(l)) |? (c => c != ' ')
  match cs {
    [] -> false
    [h, ..._] -> (h == '-' or h == '*' or h == '_')
      and cs.length() >= 3
      and all(cs, c => c == h)
  }
}

# ---- Headings ----

fn heading_at(ls: [String]) : Option[Parsed] {
  let l = first_line(ls)
  heading_level(l).map(n => (Heading(n, inline.scan(heading_text(l, n))), drop(ls, 1)))
}

# Level 1..6 from the leading `#`. A `#` glued to the text (`#hashtag`)
# opens no heading.
fn heading_level(l: String) : Option[Int] {
  let t = trim_left(l)
  let n = count_prefix(chars(t), '#')
  let body = slice(t, n, length(t) - n)
  if n >= 1 and n <= 6 and (starts_with(body, " ") or is_empty(body)) {
    Some(n)
  } else {
    None
  }
}

# The heading text, without the opening `#` nor the optional closing
# ones (`## Title ##`).
fn heading_text(l: String, level: Int) : String {
  let t = trim_left(l)
  let body = trim(slice(t, level, length(t) - level))
  trim(drop_suffix_run(body, "#"))
}

# ---- Code blocks ----

fn code_at(ls: [String]) : Option[Parsed] {
  let opener = first_line(ls)
  fence_marker(opener).map(marker => take_code(opener, marker, drop(ls, 1)))
}

# The opening fence marker, when the line opens one.
fn fence_marker(l: String) : Option[String] {
  let t = trim_left(l)
  if starts_with(t, "```") {
    Some("```")
  } else if starts_with(t, "~~~") {
    Some("~~~")
  } else {
    None
  }
}

# Consumes up to the closing fence. An unclosed block runs to the end of
# the document: it is closed there rather than dropping the content.
fn take_code(opener: String, marker: String, rest: [String]) : Parsed {
  let t = trim_left(opener)
  let lang = trim(slice(t, marker.length(), t.length() - marker.length()))
  let (body, tail) = span(rest, l => fence_marker(l) != Some(marker))
  (Code(lang, body), drop(tail, 1))
}

# ---- Indented code ----

# Four spaces, or a tab, open a code block wherever a block may start.
# Inside a paragraph the same indent is a continuation line instead,
# which is why `interrupts_para` deliberately leaves this one out.
fn indented_code_at(ls: [String]) : Option[Parsed] =
  if is_indented(first_line(ls)) { Some(take_indented(ls, [], 0)) } else { None }

fn is_indented(l: String) : Bool =
  (not is_blank(l))
    and (starts_with(l, "    ") or starts_with(l, "\t"))

# Blank lines are carried as a count and only paid for when another
# indented line follows: the ones trailing the block belong to the
# document, not to the code.
fn take_indented(ls: [String], acc: [String], blanks: Int) : Parsed = match ls {
  [] -> (Code("", reverse(acc)), [])
  [h, ...t] ->
    if is_blank(h) {
      take_indented(t, acc, blanks + 1)
    } else if is_indented(h) {
      take_indented(t, [strip_indent(h), ...blank_run(blanks, acc)], 0)
    } else {
      (Code("", reverse(acc)), ls)
    }
}

fn blank_run(n: Int, acc: [String]) : [String] =
  if n <= 0 { acc } else { blank_run(n - 1, ["", ...acc]) }

# One level of indent only, so deeper indentation survives into the code.
fn strip_indent(l: String) : String =
  drop_prefix(l, "    ").or_else(() => drop_prefix(l, "\t")).unwrap_or(l)

# ---- Quotes ----

fn quote_at(ls: [String]) : Option[Parsed] =
  if is_quote(first_line(ls)) { Some(take_quote(ls)) } else { None }

fn is_quote(l: String) : Bool = starts_with(trim(l), ">")

fn take_quote(ls: [String]) : Parsed {
  let (quoted, rest) = span(ls, is_quote)
  (Quote(blocks(quoted | strip_quote)), rest)
}

# Drops the `>` and the space that usually follows it.
fn strip_quote(l: String) : String {
  let t = trim_left(l)
  let body = slice(t, 1, t.length() - 1)
  drop_prefix(body, " ").unwrap_or(body)
}

# ---- Lists ----

fn bullets_at(ls: [String]) : Option[Parsed] =
  bullet_marker(first_line(ls)).map(marker => take_bullets(ls, []))

fn ordered_at(ls: [String]) : Option[Parsed] =
  ordered_start(first_line(ls)).map(n => take_ordered(ls, n, []))

# The bullet marker (`-`, `*` or `+` followed by a space).
fn bullet_marker(l: String) : Option[String] {
  let t = trim_left(l)
  if starts_with(t, "- ") {
    Some("-")
  } else if starts_with(t, "* ") {
    Some("*")
  } else if starts_with(t, "+ ") {
    Some("+")
  } else {
    None
  }
}

# The number an ordered item opens with (`1. ` or `1) `).
fn ordered_start(l: String) : Option[Int] {
  let t = trim_left(l)
  let digits = count_digits(chars(t))
  let after = slice(t, digits, t.length() - digits)
  if digits > 0 and (starts_with(after, ". ") or starts_with(after, ") ")) {
    to_int(slice(t, 0, digits))
  } else {
    None
  }
}

# `acc` gathers items backwards and is reversed on the way out; the
# append form would copy every item collected so far on each one.
fn take_bullets(ls: [String], acc: [ast.Item]) : Parsed {
  let l = first_line(ls)
  if bullet_marker(l) == None or is_rule(l) {
    (Bullets(reverse(acc)), ls)
  } else {
    let (item, rest) = take_item(ls, marker_width(l, 2))
    take_bullets(rest, [item, ...acc])
  }
}

fn take_ordered(ls: [String], start: Int, acc: [ast.Item]) : Parsed {
  let l = first_line(ls)
  if ordered_start(l) == None {
    (Ordered(start, reverse(acc)), ls)
  } else {
    let width = marker_width(l, count_digits(chars(trim_left(l))) + 2)
    let (item, rest) = take_item(ls, width)
    take_ordered(rest, start, [item, ...acc])
  }
}

# How many columns the marker occupies counting its indent, so an item's
# continuation lines de-indent to the same column as its text.
fn marker_width(l: String, mark_len: Int) : Int =
  l.length() - trim_left(l).length() + mark_len

# An item: its first line without the marker, plus the following
# indented lines belonging to it, all reparsed as blocks. A task box
# comes off the front of that first line — it is the item's state, not
# a pair of brackets in its text.
fn take_item(ls: [String], indent: Int) : (ast.Item, [String]) {
  let l = first_line(ls)
  let (task, head) = task_box(slice(l, indent, l.length() - indent))
  let (body, rest) = take_continuation(drop(ls, 1), indent, [])
  (ast.Item { task: task, blocks: blocks([head, ...body]) }, rest)
}

# `[ ] ` and `[x] ` open a task item; the space after the box is what
# keeps a paragraph opening with a reference from becoming one.
fn task_box(head: String) : (Option[Bool], String) {
  let t = trim_left(head)
  if starts_with(t, "[ ] ") {
    (Some(false), slice(t, 4, chars(t).length() - 4))
  } else if starts_with(t, "[x] ") or starts_with(t, "[X] ") {
    (Some(true), slice(t, 4, chars(t).length() - 4))
  } else {
    (None, head)
  }
}

fn take_continuation(ls: [String], indent: Int, acc: [String]) : ([String], [String]) =
  match ls {
    [] -> (reverse(acc), [])
    [h, ...t] ->
      if is_blank(h) or (not starts_with(h, repeat(" ", indent))) {
        (reverse(acc), ls)
      } else {
        take_continuation(t, indent, [slice(h, indent, h.length() - indent), ...acc])
      }
  }

# ---- Tables ----

# A table is two lines before it is one: a header, and under it the
# delimiter row that declares the alignments. Neither is a table on its
# own, which is what keeps a paragraph holding a `|` from becoming one.
# The counts must agree, as they do in GFM — a mismatch is prose.
fn table_at(ls: [String]) : Option[Parsed] = match ls {
  [h, d, ...rest] -> {
    let head = split_row(h)
    match delimiter_row(d) {
      Some(aligns) ->
        if aligns.length() == head.length() and head.length() >= 1 {
          Some(take_table(head, aligns, rest, []))
        } else {
          None
        }
      None -> None
    }
  }
  _ -> None
}

# The rows run until a blank line or anything that stopped being a row.
# `acc` gathers backwards and is reversed on the way out.
fn take_table(
  head: [String],
  aligns: [ast.Align],
  ls: [String],
  acc: [[[ast.Inline]]]
) : Parsed {
  let l = first_line(ls)
  if ls.is_empty() or is_blank(l) or (not has_pipe(l)) {
    (Table(head | inline.scan, aligns, reverse(acc)), ls)
  } else {
    let row = fit_row(split_row(l), aligns.length()) | inline.scan
    take_table(head, aligns, drop(ls, 1), [row, ...acc])
  }
}

# A ragged row is squared off here rather than in the renderer: short
# rows gain empty cells, long ones lose the surplus. Dropping a cell is
# what GFM does, and the alternative — a column the header never
# announced — has no width and no alignment to be drawn with.
fn fit_row(cells: [String], n: Int) : [String] {
  let short = n - cells.length()
  if short <= 0 { take(cells, n) } else { cells ++ list.repeat("", short) }
}

fn has_pipe(l: String) : Bool = chars(l).contains('|')

# The delimiter row: every cell a run of `-` with an optional `:` at
# either end. It must carry a pipe of its own, which is what keeps a
# setext underline from opening a one-column table — `Title` over
# `-----` is a heading, and only `| --- |` is a table.
fn delimiter_row(l: String) : Option[[ast.Align]] =
  if not has_pipe(l) {
    None
  } else {
    let cells = split_row(l)
    if cells.is_empty() or (not all(cells, is_delimiter)) {
      None
    } else {
      Some(cells | alignment)
    }
  }

fn is_delimiter(c: String) : Bool {
  let core = trim(drop_edge(drop_edge(trim(c), ":", true), ":", false))
  (not is_empty(core)) and all(chars(core), ch => ch == '-')
}

fn alignment(c: String) : ast.Align {
  let t = trim(c)
  match (starts_with(t, ":"), ends_with(t, ":")) {
    (true, true) -> AlignCenter
    (false, true) -> AlignRight
    _ -> AlignLeft
  }
}

fn drop_edge(s: String, edge: String, front: Bool) : String {
  let dropped = if front { drop_prefix(s, edge) } else { drop_suffix(s, edge) }
  dropped.unwrap_or(s)
}

# Splits a row on its unescaped pipes, dropping the optional outer pair
# so `| a | b |` and `a | b` cut the same. A `\|` stays in the cell for
# the inline scanner to unescape, which is where every other escape is
# resolved too.
fn split_row(l: String) : [String] {
  let t = drop_edge(drop_edge(trim(l), "|", true), "|", false)
  cut_cells(chars(t), [], []) | trim
}

fn cut_cells(cs: [Char], cell: [Char], acc: [String]) : [String] = match cs {
  [] -> reverse([from_chars(reverse(cell)), ...acc])
  ['\\', p, ...t] -> cut_cells(t, [p, '\\', ...cell], acc)
  [c, ...t] ->
    if c == '|' {
      cut_cells(t, [], [from_chars(reverse(cell)), ...acc])
    } else {
      cut_cells(t, [c, ...cell], acc)
    }
}

# ---- Paragraphs ----

# Runs to a blank line or the start of another block, which is what
# allows a list to be written straight after a paragraph.
fn take_para(ls: [String], acc: [String]) : Parsed = match ls {
  [] -> (para_of(acc), [])
  [h, ...t] ->
    match setext_level(h) {
      Some(n) if acc.length() > 0 -> (Heading(n, inline.scan(para_text(acc))), t)
      _ ->
        if acc.length() > 0 and (is_blank(h) or interrupts_para(h)) {
          (para_of(acc), ls)
        } else {
          take_para(t, [h, ...acc])
        }
    }
}

# The underline of a setext heading: a run of `=` titles level 1, one of
# `-` level 2. `---` reads as a rule too, and the ambiguity resolves by
# position — with a paragraph above it the heading wins, and standing
# alone it never reaches here, `block_at` having taken it as a rule.
fn setext_level(l: String) : Option[Int] {
  let cs = chars(trim(l))
  match cs {
    [] -> None
    [h, ..._] ->
      if not all(cs, c => c == h) {
        None
      } else if h == '=' {
        Some(1)
      } else if h == '-' {
        Some(2)
      } else {
        None
      }
  }
}

# The lines arrive backwards and untrimmed, because the trailing spaces
# are the message: two of them, or a closing backslash, are how the
# source insists on a break. Every other newline is a space — the
# renderer decides where the text wraps.
fn para_text(acc: [String]) : String = string.join(weave(reverse(acc), []), "")

# The separator is pushed as a fragment of its own rather than glued to
# the line: the join at the end walks them all once anyway, and a fresh
# string per line is what a long paragraph cannot afford.
fn weave(ls: [String], out: [String]) : [String] = match ls {
  [] -> reverse(out)
  [l] -> reverse([trim(l), ...out])
  [l, ...t] -> {
    let hard = hard_break(l)
    weave(t, [if hard { "\n" } else { " " }, body_of(l, hard), ...out])
  }
}

# Both spellings show at the end of the raw line, so recognising either
# costs no copy of it.
fn hard_break(l: String) : Bool = ends_with(l, "  ") or ends_with(l, "\\")

# The backslash spelling of a break is not part of the text it breaks.
# An ordinary line pays only for the trim it always paid for.
fn body_of(l: String, hard: Bool) : String {
  let t = trim(l)
  if hard { trim(drop_suffix(t, "\\").unwrap_or(t)) } else { t }
}

fn para_of(acc: [String]) : ast.Block = Para(inline.scan(para_text(acc)))

fn interrupts_para(l: String) : Bool =
  is_rule(l)
    or is_quote(l)
    or heading_level(l) != None
    or fence_marker(l) != None
    or bullet_marker(l) != None
    or ordered_start(l) != None

# ---- Character helpers ----

fn count_prefix(cs: [Char], c: Char) : Int = take_while(cs, h => h == c).length()

fn count_digits(cs: [Char]) : Int = take_while(cs, is_digit).length()

fn drop_suffix_run(s: String, suffix: String) : String =
  match drop_suffix(s, suffix) {
    Some(r) -> drop_suffix_run(r, suffix)
    None -> s
  }

fn lookup(defs: Defs, key: String) : Option[String] =
  find_map(defs, d => if d.fst == key { Some(d.snd) } else { None })
