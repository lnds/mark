#[doc("""
Reading the command line: a pure function from `[String]` to `Opts`,
touching no environment. `main.kai` hands it `args.argv()` and resolves
afterwards whatever depends on the terminal (real width, colour).
""")]

pub const VERSION : String = "0.6.0"

#[doc("""
Where the document comes from, as far as the arguments settle it.

`Browse` is the one that is not settled: with no argument there is a
directory to choose from rather than a document to read, and only
`main` — which may look at the filesystem and the terminal — can turn
it into a file, the help, or nothing at all.
""")]
#[derive(Eq, Show)]
pub type Source
  = FromFile(String)
  | Browse(String)
  | FromStdin
  | ShowHelp
  | ShowVersion
  | Invalid(String)

#[doc("""
The whole invocation. `width == 0` and `style == "auto"` mean "decide
this by looking at the terminal": the CLI does not resolve what depends
on the environment, it only records that it was left unset.
""")]
pub type Opts = {
  source: Source,
  width: Int,
  style: String,
  color: String,
  pager: String,
  images: String
}

fn defaults() : Opts =
  Opts {
    source: Browse("."),
    width: 0,
    style: "auto",
    color: "auto",
    pager: "auto",
    images: "auto"
  }

pub fn parse_args(argv: [String]) : Opts = match argv {
  [] -> defaults()
  _ -> walk(argv, Opts { ...defaults(), source: FromStdin })
}

# The first bare argument fixes the source and later ones are ignored,
# as glow does. A bad flag propagates and stops the walk.
fn walk(argv: [String], o: Opts) : Opts = match o.source {
  Invalid(_) -> o
  _ -> match argv {
    [] -> o
    ["-h", ...t] -> walk(t, Opts { ...o, source: ShowHelp })
    ["--help", ...t] -> walk(t, Opts { ...o, source: ShowHelp })
    ["-v", ...t] -> walk(t, Opts { ...o, source: ShowVersion })
    ["--version", ...t] -> walk(t, Opts { ...o, source: ShowVersion })
    ["-", ...t] -> walk(t, Opts { ...o, source: FromStdin })
    ["-w", n, ...t] -> walk(t, with_width(o, n))
    ["--width", n, ...t] -> walk(t, with_width(o, n))
    ["-s", s, ...t] -> walk(t, with_style(o, s))
    ["--style", s, ...t] -> walk(t, with_style(o, s))
    ["--color", c, ...t] -> walk(t, with_color(o, c))
    ["--images", i, ...t] -> walk(t, with_images(o, i))
    ["-p", ...t] -> walk(t, Opts { ...o, pager: "always" })
    ["--pager", ...t] -> walk(t, Opts { ...o, pager: "always" })
    ["-P", ...t] -> walk(t, Opts { ...o, pager: "never" })
    ["--no-pager", ...t] -> walk(t, Opts { ...o, pager: "never" })
    [a, ...t] ->
      if starts_with(a, "-") and a != "-" {
        Opts { ...o, source: Invalid("unknown option: #{a}") }
      } else {
        walk(t, first_file(o, a))
      }
  }
}

fn first_file(o: Opts, path: String) : Opts = match o.source {
  FromStdin -> Opts { ...o, source: FromFile(path) }
  _ -> o
}

fn with_width(o: Opts, n: String) : Opts = match to_int(n) {
  Some(w) ->
    if w > 0 {
      Opts { ...o, width: w }
    } else {
      Opts { ...o, source: Invalid("width must be positive: #{n}") }
    }
  None -> Opts { ...o, source: Invalid("width is not a number: #{n}") }
}

fn with_style(o: Opts, s: String) : Opts =
  if s == "dark" or s == "light" or s == "auto" {
    Opts { ...o, style: s }
  } else {
    Opts { ...o, source: Invalid("unknown style: #{s} (dark|light|auto)") }
  }

fn with_images(o: Opts, i: String) : Opts =
  if i == "auto" or i == "kitty" or i == "iterm" or i == "never" {
    Opts { ...o, images: i }
  } else {
    Opts { ...o, source: Invalid("unknown image mode: #{i} (auto|kitty|iterm|never)") }
  }

fn with_color(o: Opts, c: String) : Opts =
  if c == "auto" or c == "always" or c == "never" {
    Opts { ...o, color: c }
  } else {
    Opts { ...o, source: Invalid("unknown colour mode: #{c} (auto|always|never)") }
  }

# A triple-quoted literal keeps the newline that follows the opening
# quotes, so the text starts glued to it to avoid a leading blank line.
pub fn help_text() : String = """mark #{VERSION} — a markdown viewer for the terminal

usage:
  mark <file.md>         render a file
  mark <dir>             choose a file from the tree under it
  mark                   the same, for the directory at hand
  mark -                 render whatever arrives on stdin
  mark -h | --help       this help
  mark -v | --version    the version

options:
  -w, --width <n>        output width (default: the terminal's, capped at 80)
  -s, --style <style>    dark | light | auto
      --color <when>     auto | always | never (NO_COLOR also disables it)
      --images <when>    auto | kitty | iterm | never (under kitty they page;
                         an iTerm2 one skips the pager unless -p asked for it)
  -p, --pager            page even when the text fits on screen
  -P, --no-pager         dump everything at once, without paging

in the pager:
  j/k, up/down           one line              space/b   one page
  d/u                    half a page           g/G       start/end
  q, Esc                 quit

in the file picker:
  j/k, up/down           one entry             space/b   one page
  enter                  open it               g/G       start/end
  q, Esc                 quit"""
