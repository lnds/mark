#[doc("""
mark — a markdown viewer for the terminal.

CLI entry point: resolves the source (file or stdin) and whatever
depends on the terminal (width, colour), hands the text to the pure
parse -> render pipeline, and writes the result out.
""")]

import fs.dir
import fs.file
import math.int
import os.args
import os.env
import mark.ast
import mark.cli
import mark.parser
import mark.render
import mark.theme
import mark.tty
import mark.pager
import mark.finder
import mark.image

# Drains stdin line by line to EOF, gathering backwards so the join is
# the only pass over the whole input.
fn read_stdin(acc: [String]) : String / Stdin = match Stdin.read_line() {
  None -> join(reverse(acc), "\n")
  Some(line) -> read_stdin([line, ...acc])
}

fn load(src: cli.Source) : Result[String, String] / File + Stdin {
  case ShowHelp -> Ok(cli.help_text())
  case ShowVersion -> Ok("mark #{cli.VERSION}")
  case FromStdin -> Ok(read_stdin([]))
  case FromFile(p) -> File.read_file(p).map_err(e => failure(p, e))
  case Invalid(msg) -> Err("mark: #{msg}")
  # `resolve` has already turned this into a file, the help or nothing.
  case Browse(_) -> Ok(cli.help_text())
}

# An empty directory reaches here rather than the finder, which asks the
# filesystem for its entries and is told there are none. The message it
# gets back says so plainly instead of quoting a syscall at it.
fn failure(path: String, e: String) : String =
  if char_index_of(e, "is a directory") != None {
    "mark: #{path} is a directory with no markdown in it"
  } else {
    "mark: cannot read #{path}: #{e}"
  }

# Text that is already the final output — the help, the version — does
# not go through the renderer: reformatting it would only spoil it.
fn verbatim(src: cli.Source) : Bool {
  case ShowHelp -> true
  case ShowVersion -> true
  case _ -> false
}

# An explicit width always wins; otherwise the terminal's, capped at 80,
# which is where a line stops being comfortable to read.
#
# With a terminal on the other end the pager's margin is subtracted even
# when the output ends up dumped: a line that overflows it breaks the
# repaint, and three columns less in a dump go unnoticed.
fn width_for(o: cli.Opts) : Int / Ffi + Stdout {
  let usable =
    if tty.is_terminal() { tty.columns() - pager.margin() } else { tty.columns() }
  if o.width > 0 { o.width } else { int.min(usable, 80) }
}

# `--color` overrides everything; `auto` looks at NO_COLOR and then at
# whether stdout is a terminal, which is the convention pipes and
# redirections rely on.
fn colored(o: cli.Opts) : Bool / Env + Stdout = match o.color {
  "always" -> true
  "never" -> false
  _ -> match env.get("NO_COLOR") {
    Some(_) -> false
    None -> tty.is_terminal()
  }
}

fn theme_for(o: cli.Opts) : theme.Theme / Env + Stdout =
  if colored(o) {
    theme.by_name(if o.style == "auto" { "dark" } else { o.style })
  } else {
    theme.plain()
  }

# Paging happens when there is a terminal to page in and the document
# does not fit in it: dumping a long document loses it in the
# scrollback, and opening a TUI for four lines is worse than not opening
# one. `-p` / `-P` override.
#
# Never when the input came from stdin: the pager reads its keys from
# that same descriptor, which by then is exhausted, leaving it no way to
# be told to quit. A redirected stdin is caught by `is_interactive`
# instead, but a terminal typed into is not — it is a tty that has
# already reached EOF, and only the source says so.
fn paginate(o: cli.Opts, src: cli.Source, lines: Int) : Bool / Ffi + Stdout + Stdin =
  match src {
    FromStdin -> false
    _ -> match o.pager {
      "never" -> false
      "always" -> tty.is_interactive()
      _ -> tty.is_interactive() and lines > pager.body_rows(tty.rows())
    }
  }

fn name_of(src: cli.Source) : String {
  case FromFile(p) -> p
  case _ -> "(stdin)"
}

# A directory is a place to choose a document from, not a document. So
# is no argument at all, which means the directory at hand — unless
# there is no terminal to choose in, and then the help is the only
# useful answer.
fn resolve(src: cli.Source) : Option[cli.Source] / File + Ffi + Stdout + Stdin = match src {
  Browse(root) -> if tty.is_interactive() { pick(root) } else { Some(ShowHelp) }
  FromFile(p) ->
    if not is_directory(p) {
      Some(src)
    } else if tty.is_interactive() {
      pick(p)
    } else {
      Some(Invalid("#{p} is a directory, and choosing from one needs a terminal"))
    }
  _ -> Some(src)
}

# `None` is the picker closed without a choice: nothing to report and
# nothing to render, which is not a failure.
fn pick(root: String) : Option[cli.Source] / File + Ffi {
  let files = finder.markdown_files(root)
  if files.is_empty() {
    Some(Invalid("no markdown files under #{root}"))
  } else {
    let rows = pager.body_rows(tty.rows()) + 1
    finder.run(files, root, rows, tty.columns() - pager.margin()).map(f => FromFile(f))
  }
}

# ---- Pictures ----

# The one place a byte is read for an image, and the one place the
# terminal is written to directly. The pipeline downstream is pure, so
# the file is opened here and what travels on is a block of lines —
# `render` never learns there was a disk.
#
# Every placed image needs an id of its own, which is what the counter
# threads through: the terminal keeps them apart by it.
#
# A paragraph that is nothing but images becomes a picture — one, or
# several laid out side by side. An image sharing a line with words
# would have to be measured against them, and that is a layout this does
# not attempt: that one keeps its alt text.
fn with_pictures(
  proto: image.Protocol,
  bs: [ast.Block],
  id: Int,
  width: Int
) : ([ast.Block], Int) / File + Ffi = match bs {
  [] -> ([], id)
  [b, ...rest] -> {
    let (drawn, next) = picture_block(proto, b, id, width)
    let (others, last) = with_pictures(proto, rest, next, width)
    ([drawn, ...others], last)
  }
}

fn picture_block(
  proto: image.Protocol,
  b: ast.Block,
  id: Int,
  width: Int
) : (ast.Block, Int) / File + Ffi = match b {
  Para(xs) -> match only_images(xs, []) {
    Some(imgs) -> pictures(proto, imgs, id, width)
    None -> (b, id)
  }
  Quote(inner) -> {
    let (drawn, next) = with_pictures(proto, inner, id, width - 2)
    (Quote(drawn), next)
  }
  other -> (other, id)
}

# Every node an image, or the whitespace the source left between two of
# them. A single word among them and this is prose with pictures in it,
# which is a different layout problem.
fn only_images(
  xs: [ast.Inline],
  acc: [([ast.Inline], String)]
) : Option[[([ast.Inline], String)]] = match xs {
  [] -> if acc.is_empty() { None } else { Some(reverse(acc)) }
  [Image(alt, src), ...t] -> only_images(t, [(alt, src), ...acc])
  [ast.Text(s), ...t] -> if is_blank(s) { only_images(t, acc) } else { None }
  _ -> None
}

# The pictures of one paragraph, laid out together. A placed one becomes
# a tile the band packer arranges; a drawn one becomes its sequence, and
# consecutive sequences flow side by side because the terminal advances
# the cursor past each picture itself.
#
# All or nothing: if any image in the paragraph cannot be drawn, the
# whole paragraph keeps its alt text rather than showing half a row.
fn pictures(
  proto: image.Protocol,
  imgs: [([ast.Inline], String)],
  id: Int,
  width: Int
) : (ast.Block, Int) / File + Ffi {
  let fallback = (Para(intersperse_images(imgs)), id)
  let (tiles, next) = tiles_for(proto, imgs, id, [])
  match tiles {
    None -> fallback
    Some(ts) -> match proto {
      Placed(_, _) -> (Picture(image.bands(ts, width), alt_of(imgs)), next)
      # Not placed, so not laid out either: the sequences go on one line
      # and the terminal decides where each picture lands.
      _ -> (Picture([join(ts | (t => join(t.fst, "")), "")], alt_of(imgs)), next)
    }
  }
}

# A file that cannot be read is not an error worth stopping for: the
# document still says what the picture was, which is more than a dead
# process would. The same goes for one whose size cannot be found —
# only PNG says it in a header, and only PNG is what the protocols here
# transmit.
fn tiles_for(
  proto: image.Protocol,
  imgs: [([ast.Inline], String)],
  id: Int,
  acc: [([String], Int)]
) : (Option[[([String], Int)]], Int) / File + Ffi = match imgs {
  [] -> (Some(reverse(acc)), id)
  [(_, src), ...rest] -> match tile(proto, src, id) {
    None -> (None, id)
    Some((t, next)) -> tiles_for(proto, rest, next, [t, ...acc])
  }
}

fn tile(
  proto: image.Protocol,
  src: String,
  id: Int
) : Option[(([String], Int), Int)] / File + Ffi = match file.read_bytes(src) {
  Err(_) -> None
  Ok(buf) -> match proto {
    Placed(cw, ch) -> match image.png_size(buf) {
      None -> None
      Some((w, h)) -> {
        let (cols, rows) = image.cells_for(w, h, cw, ch)
        if rows > image.max_rows() {
          None
        } else {
          image.install(id, buf, cols, rows)
          Some(((image.grid(id, cols, rows), cols), id + 1))
        }
      }
    }
    # Not placed, so no width to report: the terminal decides where the
    # drawing lands and how much room it takes.
    _ -> image.sequence(proto, buf).map(seq => (([seq], 0), id))
  }
}

# The paragraph as it was, for the fallback: the images with the single
# space the source had between them.
fn intersperse_images(imgs: [([ast.Inline], String)]) : [ast.Inline] =
  intersperse(imgs | (p => ast.Image(p.fst, p.snd)), ast.Text(" "))

fn alt_of(imgs: [([ast.Inline], String)]) : [ast.Inline] = imgs || (.fst)

# `fs.dir.list_dir` answers with the entries or with nothing at all, so
# an empty directory reads as a file here and is caught by the read.
fn is_directory(path: String) : Bool / File = not dir.list_dir(path).is_empty()

# A placed picture is ordinary text as far as everything downstream is
# concerned — a block of placeholder cells one column wide each — so it
# pages like prose and nothing here has to choose between the two.
#
# A picture that could not be placed can only be drawn where the cursor
# stands, and that one cannot be paged: the repaint measures its lines
# and an escape sequence has no width. There the picture wins over the
# pager mark would have opened on its own, but not over a `-p` that
# asked for the pager by name.
#
# The terminal is asked only when the document has something to draw.
# The query costs a round trip, and a silent terminal costs the whole
# budget, which no ordinary document should pay for.
fn show(
  opts: cli.Opts,
  src: cli.Source,
  doc: [ast.Block]
) : Unit / Stdout + Env + File + Ffi + Stdin {
  let th = theme_for(opts)
  let width = width_for(opts)
  let found =
    if draws_anything(doc) { place_if_possible(image.detect(opts.images)) } else { NoImages }
  # A protocol that cannot be paged loses to a `-p` that asked for the
  # pager by name. An explicit flag going quietly ignored is worse than
  # either outcome it was choosing between.
  let proto = if pages_with(found) or opts.pager != "always" { found } else { NoImages }
  let (drawn, _) =
    if proto == NoImages { (doc, 0) } else { with_pictures(proto, doc, FIRST_ID, width) }
  let lines = render.render(th, width, drawn)
  if pages_with(proto) and paginate(opts, src, lines.length()) {
    pager.run(lines, name_of(src))
  } else {
    foreach(lines, l => Stdout.print(l))
  }
}

# Where image ids start. Any number would do; a high one keeps them clear
# of whatever else in the session has been talking to the same terminal.
const FIRST_ID : Int = 4100

# Whether asking the terminal could change anything: a paragraph that is
# one image and nothing else is the only shape that becomes a picture.
fn draws_anything(bs: [ast.Block]) : Bool = any(
  bs,
  b => match b {
    Para(xs) -> is_some(only_images(xs, []))
    Quote(inner) -> draws_anything(inner)
    _ -> false
  }
)

fn main() : Int / Stdout + Stderr + Env + File + Stdin + Ffi {
  let opts = cli.parse_args(args.argv())
  match resolve(opts.source) {
    None -> 0
    Some(src) -> match load(src) {
      Err(msg) -> {
        Stderr.eprint(msg)
        1
      }
      Ok(text) -> {
        if verbatim(src) {
          Stdout.print(text)
        } else {
          show(opts, src, parser.parse(text))
        }
        0
      }
    }
  }
}

# Placement needs the cell size, which is a second question to the
# terminal, so it is only asked of a terminal that already said it draws
# kitty graphics.
fn place_if_possible(proto: image.Protocol) : image.Protocol / Ffi = match proto {
  Kitty -> match image.cell_size() {
    Some((w, h)) -> Placed(w, h)
    None -> Kitty
  }
  other -> other
}

# Whether a picture can be paged: a placed one is text, a drawn one is
# not. Only the second has to argue with the pager.
fn pages_with(proto: image.Protocol) : Bool = match proto {
  Placed(_, _) -> true
  NoImages -> true
  _ -> false
}
