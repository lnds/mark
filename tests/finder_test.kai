import mark.finder
import terevaka.term
import terevaka.ui as ui

fn docs() : [String] = ["/r/a.md", "/r/sub/b.md", "/r/sub/c.md", "/r/d.md"]

fn m3() : finder.Model = finder.model(docs(), "/r", 4)

test "an entry shows the path it does not share with the root" {
  let m = m3()
  assert finder.shown(m, "/r/sub/b.md") == "sub/b.md"
  # A root with a trailing slash cuts the same.
  assert finder.shown(finder.model(docs(), "/r/", 4), "/r/sub/b.md") == "sub/b.md"
  # A path from somewhere else is left whole rather than mangled.
  assert finder.shown(m, "/elsewhere/x.md") == "/elsewhere/x.md"
}

test "the cursor stays inside the list" {
  let m = m3()
  assert finder.move_to(m, 0 - 5).cur == 0
  assert finder.move_to(m, 99).cur == 3
  assert finder.move_to(m, 2).cur == 2
}

test "the window follows the cursor, and no further" {
  let m = m3()
  # Three body rows: moving to the fourth entry drags the top by one.
  assert m.height == 3
  assert finder.move_to(m, 3).top == 1
  assert finder.move_to(m, 2).top == 0
  # Coming back up drags it the other way.
  assert finder.move_to(finder.move_to(m, 3), 0 - 3).top == 0
}

test "the viewport is the window, relative to the root" {
  assert finder.viewport(m3()) == ["a.md", "sub/b.md", "sub/c.md"]
  assert finder.viewport(finder.move_to(m3(), 3)) == ["sub/b.md", "sub/c.md", "d.md"]
}

test "a key is a decision: stay, open, or leave" {
  let m = m3()
  assert finder.step(m, Printable('q')) == Leave
  assert finder.step(m, Esc) == Leave
  assert finder.step(m, Enter) == Open("/r/a.md")
  assert finder.step(finder.move_to(m, 1), Enter) == Open("/r/sub/b.md")
  assert finder.step(m, Printable('j')) == Stay(finder.move_to(m, 1))
  assert finder.step(m, Printable('G')) == Stay(finder.move_to(m, 4))
}

test "an empty list has nothing to open" {
  let empty = finder.model([], "/r", 4)
  assert finder.current(empty) == None
  assert finder.step(empty, Enter) == Leave
  assert finder.viewport(empty) == []
  # With no entries there is no entry to be on: the cursor stays at
  # nought however it is pushed, rather than pointing past the list.
  assert cur_after(empty, Printable('j')) == 0
  assert cur_after(empty, Printable('G')) == 0
}

test "the status bar is cut to the width, never past it" {
  let m = m3()
  assert finder.status(m, 30).length() == 30
  assert finder.status(m, 8).length() == 8
}

test "the keys appear the moment the bar has room, and not a column sooner" {
  let left = "/r  1/4"
  let keys = "j/k move · enter open · q quit"
  # Room to spare means at least the two columns that separate them.
  let exact = ui.visible_len(left) + ui.visible_len(keys) + 2
  assert finder.status(m3(), exact) == "#{left}  #{keys}"
  assert index_of(finder.status(m3(), exact - 1), "q quit") == None
}

test "a screen of one row still has a row of body" {
  # `rows - 1` hands one row to the status bar; what is left has to be a
  # row of body, or the picker opens showing no files at all.
  let tiny = finder.model(docs(), "/r", 1)
  assert tiny.height == 1
  assert finder.viewport(tiny) == ["a.md"]
}

# Where a key leaves the cursor, as an index rather than as another call
# to `move_to`: comparing one call against another says nothing when the
# clamp makes both land on the same entry.
fn cur_after(m: finder.Model, k: term.Key) : Int = match finder.step(m, k) {
  Stay(next) -> next.cur
  _ -> 0 - 1
}

test "every key moves the cursor by the distance it names" {
  # Four files in three rows of body, so the cursor runs from 0 to 3.
  let first = m3()
  let last = finder.move_to(first, 3)
  # Every spelling of "open this one".
  assert finder.step(first, Printable('o')) == Open("/r/a.md")
  assert finder.step(first, Printable('l')) == Open("/r/a.md")
  assert finder.step(first, Right) == Open("/r/a.md")
  # Down by one and by a page, from the first entry.
  assert cur_after(first, Printable('j')) == 1
  assert cur_after(first, Down) == 1
  assert cur_after(first, Printable(' ')) == 3
  assert cur_after(first, Printable('f')) == 3
  assert cur_after(first, Printable('G')) == 3
  # The same keys upward, from the last entry: at the first they would
  # all clamp to zero and a wrong distance would look right.
  assert cur_after(last, Printable('k')) == 2
  assert cur_after(last, Up) == 2
  assert cur_after(last, Printable('b')) == 0
  assert cur_after(last, Printable('g')) == 0
  # A key the picker does not know leaves it where it was, rather than
  # closing it on a stray byte — read where there is somewhere to go,
  # since at the last entry standing still and moving down agree.
  assert cur_after(last, Tick) == 3
  assert cur_after(first, Tick) == 0
}
