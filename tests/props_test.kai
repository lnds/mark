import mark.parser
import mark.render
import mark.theme

# Invariants that hold for any input, not just the cases I thought of:
# the generator hunts for the counterexample instead of me.

check "no rendered line hides a newline" with s: String {
  render.render(theme.plain(), 40, parser.parse(s))
    |> (ls => all(ls, l => index_of(l, "\n") == None))
}

check "the requested width holds, bar one indivisible word" with s: String {
  render.render(theme.plain(), 40, parser.parse(s))
    |> (ls => all(ls, l => fits(l, 40)))
}

# A word wider than the margin comes out whole rather than split, so a
# line only exceeds the width when it has nowhere to break.
fn fits(l: String, width: Int) : Bool =
  length(l) <= width or index_of(trim(l), " ") == None

fn main() : Int = 0
