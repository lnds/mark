import mark.inline
import mark.ast

test "plain text stays a single node" {
  assert inline.scan("hello world") == [Text("hello world")]
  assert inline.scan("") == []
}

test "emphasis, plain and strong" {
  assert inline.scan("*x*") == [Emph([Text("x")])]
  assert inline.scan("_x_") == [Emph([Text("x")])]
  assert inline.scan("**x**") == [Strong([Text("x")])]
  assert inline.scan("__x__") == [Strong([Text("x")])]
  let mixed = inline.scan("a **b** c")
  assert mixed == [Text("a "), Strong([Text("b")]), Text(" c")]
}

test "inline code: the content stays raw" {
  assert inline.scan("`a*b*`") == [CodeSpan("a*b*")]
  assert inline.scan("use `x` here") == [Text("use "), CodeSpan("x"), Text(" here")]
}

test "links: the label is rescanned, the destination is not" {
  assert inline.scan("[t](u)") == [Link([Text("t")], "u")]
  let emph = inline.scan("[*t*](http://a/b_c)")
  assert emph == [Link([Emph([Text("t")])], "http://a/b_c")]
}

test "an unclosed delimiter degrades to text, losing no content" {
  assert inline.scan("*abc") == [Text("*abc")]
  assert inline.scan("`abc") == [Text("`abc")]
  assert inline.scan("[abc") == [Text("[abc")]
  # A bare `[label]` may still be a reference: only `parser.parse`, which
  # has read every definition, can rule that out.
  assert inline.scan("[t]no destination") == [Ref([Text("t")], "t"), Text("no destination")]
}

test "escapes turn a delimiter literal" {
  assert inline.scan("\\*not\\*") == [Text("*not*")]
  assert inline.scan("a \\_ b") == [Text("a _ b")]
}

test "false openings do not start emphasis" {
  assert inline.scan("2 * 3 * 4") == [Text("2 * 3 * 4")]
  assert inline.scan("snake_case_here") == [Text("snake_case_here")]
}

test "a node nests the others" {
  let nested = inline.scan("**a `c`**")
  assert nested == [Strong([Text("a "), CodeSpan("c")])]
}

fn main() : Int = 0

test "strikethrough is a delimiter like the others" {
  assert inline.scan("~~gone~~") == [Strike([Text("gone")])]
  assert inline.scan("~~a~~ b") == [Strike([Text("a")]), Text(" b")]
  # Unclosed, or slack against the delimiter, it is text.
  assert inline.scan("~~open") == [Text("~~open")]
  assert inline.scan("~~ no ~~") == [Text("~~ no ~~")]
}

test "a link title is dropped, its destination is not" {
  assert inline.scan("[a](b \"the title\")") == [Link([Text("a")], "b")]
  # Angle brackets fence the whole destination, so a space inside is not
  # the start of a title.
  assert inline.scan("[a](<b c>)") == [Link([Text("a")], "b c")]
}

test "autolinks and bare URLs are links the source spelled out" {
  assert inline.scan("<https://x.example>")
    == [Link([Text("https://x.example")], "https://x.example")]
  assert inline.scan("<a@b.example>") == [Link([Text("a@b.example")], "mailto:a@b.example")]
  assert inline.scan("see https://x.example now")
    == [Text("see "), Link([Text("https://x.example")], "https://x.example"), Text(" now")]
  # The full stop ended the sentence, not the address.
  assert inline.scan("at https://x.example.")
    == [Text("at "), Link([Text("https://x.example")], "https://x.example"), Text(".")]
}

test "a tag is dropped and its text kept; a lone angle is text" {
  assert inline.scan("a <em>word</em> here") == [Text("a word here")]
  assert inline.scan("<!-- hidden -->x") == [Text("x")]
  assert inline.scan("a < b and c > d") == [Text("a < b and c > d")]
}

test "entities decode, named and numeric alike" {
  assert inline.scan("a &amp; b") == [Text("a & b")]
  assert inline.scan("&hellip;&mdash;") == [Text("…—")]
  assert inline.scan("&#8212;&#x2014;") == [Text("——")]
  # A name that is not one keeps its ampersand.
  assert inline.scan("a &nope; b") == [Text("a &nope; b")]
  assert inline.scan("AT&T") == [Text("AT&T")]
}

test "an image is a link with a bang, in every spelling" {
  assert inline.scan("![alt](pic.png)") == [Image([Text("alt")], "pic.png")]
  assert inline.scan("![alt][k]") == [ImageRef([Text("alt")], "k")]
  assert inline.scan("![Alt][]") == [ImageRef([Text("Alt")], "alt")]
  assert inline.scan("![alt]") == [ImageRef([Text("alt")], "alt")]
  # The label is rescanned like any other; the source is not.
  assert inline.scan("![*a*](p_q.png)") == [Image([Emph([Text("a")])], "p_q.png")]
}

test "a bang that opens nothing keeps both its characters" {
  assert inline.scan("![alt") == [Text("![alt")]
  assert inline.scan("a ! b") == [Text("a ! b")]
  assert inline.scan("\\![no](x)") == [Text("!"), Link([Text("no")], "x")]
}

test "a caret makes the brackets a footnote, not a reference" {
  assert inline.scan("nota[^1]") == [Text("nota"), NoteRef("1")]
  assert inline.scan("[^Nota Larga]") == [NoteRef("nota larga")]
  # Without the caret it is a reference as before.
  assert inline.scan("[1]") == [Ref([Text("1")], "1")]
  # An image cannot be a footnote, so the bang keeps it a reference.
  assert inline.scan("![^x]") == [ImageRef([Text("^x")], "^x")]
}

test "every closing punctuation ends the sentence, not the address" {
  # `trailing_noise` names seven, and each has to be the one that decides.
  let u = "https://x.example"
  assert inline.scan("a #{u},") == [Text("a "), Link([Text(u)], u), Text(",")]
  assert inline.scan("a #{u};") == [Text("a "), Link([Text(u)], u), Text(";")]
  assert inline.scan("a #{u}:") == [Text("a "), Link([Text(u)], u), Text(":")]
  assert inline.scan("a #{u}!") == [Text("a "), Link([Text(u)], u), Text("!")]
  assert inline.scan("a #{u}?") == [Text("a "), Link([Text(u)], u), Text("?")]
  assert inline.scan("(#{u})") == [Text("("), Link([Text(u)], u), Text(")")]
  # A slash is part of the address, not punctuation after it.
  assert inline.scan("#{u}/") == [Link([Text("#{u}/")], "#{u}/")]
}

test "a numeric entity outside the codepoints is not one" {
  # `from_radix` guards `acc > 0 and acc <= 1114111`, and both ends matter.
  assert inline.scan("&#0;") == [Text("&#0;")]
  assert inline.scan("&#x0;") == [Text("&#x0;")]
  # One past the last codepoint.
  assert inline.scan("&#1114112;") == [Text("&#1114112;")]
  assert inline.scan("&#x110000;") == [Text("&#x110000;")]
  # The last codepoint itself still decodes.
  assert inline.scan("&#x10FFFF;") != [Text("&#x10FFFF;")]
  # A digit the radix does not have: `a` is not decimal.
  assert inline.scan("&#1a;") == [Text("&#1a;")]
}

test "a label closes on the balanced bracket, not the first one" {
  # `[a [b] c](u)` is one link. Cutting at the first `]` turned it into
  # a reference followed by litter.
  assert inline.scan("[a [b] c](u)")
    == [Link([Text("a "), Ref([Text("b")], "b"), Text(" c")], "u")]
  assert inline.scan("[t[^1]](u)") == [Link([Text("t"), NoteRef("1")], "u")]
  assert inline.scan("![a[^1]](p.png)") == [Image([Text("a"), NoteRef("1")], "p.png")]
  # An escaped bracket is still litter rather than depth.
  assert inline.scan("[a \\[b\\] c](u)") == [Link([Text("a [b] c")], "u")]
  # Unbalanced: the outer bracket degrades to text and the inner one
  # still opens the link it is.
  assert inline.scan("[a [b c](u)") == [Text("[a "), Link([Text("b c")], "u")]
}

test "a destination is trimmed of the space around it" {
  assert inline.scan("[a](  u  )") == [Link([Text("a")], "u")]
  assert inline.scan("[a](<  u  >)") == [Link([Text("a")], "u")]
}

test "a hex entity takes both cases, and stops where the alphabet does" {
  # `digit_value` has one branch per case and each needs its boundary:
  # `f` and `F` decode, the letters just past them do not.
  assert inline.scan("&#x7a;") == [Text("z")]
  assert inline.scan("&#x5A;") == [Text("Z")]
  assert inline.scan("&#xab;") == [Text("«")]
  assert inline.scan("&#xAB;") == [Text("«")]
  # `g` is past `f`, and `G` past `F`: neither is a hex digit.
  assert inline.scan("&#xg;") == [Text("&#xg;")]
  assert inline.scan("&#xG;") == [Text("&#xG;")]
  # A hex digit is not a decimal one.
  assert inline.scan("&#a;") == [Text("&#a;")]
}
