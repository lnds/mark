import mark.cli

test "no arguments means the directory at hand, for main to settle" {
  assert cli.parse_args([]).source == Browse(".")
}

test "flags and a file" {
  assert cli.parse_args(["-h"]).source == ShowHelp
  assert cli.parse_args(["--version"]).source == ShowVersion
  assert cli.parse_args(["-"]).source == FromStdin
  assert cli.parse_args(["doc.md"]).source == FromFile("doc.md")
}

test "options and the file coexist, in any order" {
  let a = cli.parse_args(["-w", "60", "doc.md"])
  assert a.source == FromFile("doc.md")
  assert a.width == 60
  let b = cli.parse_args(["doc.md", "--style", "light", "--color", "never"])
  assert b.source == FromFile("doc.md")
  assert b.style == "light"
  assert b.color == "never"
}

test "the pager can be forced either way" {
  assert cli.parse_args(["-p", "doc.md"]).pager == "always"
  assert cli.parse_args(["--no-pager", "doc.md"]).pager == "never"
}

test "what is left unset waits for the terminal" {
  let d = cli.parse_args(["doc.md"])
  assert d.width == 0
  assert d.style == "auto"
  assert d.color == "auto"
  assert d.pager == "auto"
}

test "the first file wins; later ones are ignored" {
  assert cli.parse_args(["one.md", "two.md"]).source == FromFile("one.md")
}

test "a bad argument becomes the error to report" {
  assert cli.parse_args(["-z"]).source == Invalid("unknown option: -z")
  assert cli.parse_args(["-w", "x"]).source == Invalid("width is not a number: x")
  assert cli.parse_args(["-w", "0"]).source == Invalid("width must be positive: 0")
  assert cli.parse_args(["-s", "blue"]).source
    == Invalid("unknown style: blue (dark|light|auto)")
}

test "a bad argument stops the walk where it happened" {
  # The error is the whole report, so nothing after it may overwrite it
  # or quietly set an option behind it.
  let o = cli.parse_args(["-w", "x", "--width", "60", "-p", "doc.md"])
  assert o.source == Invalid("width is not a number: x")
  assert o.width == 0
  assert o.pager == "auto"
}

test "one column is a width; nothing below one is" {
  # What the parser rejects is a width that is not positive. A width too
  # narrow to read is the renderer's floor, not this one's.
  assert cli.parse_args(["-w", "1", "doc.md"]).width == 1
  assert cli.parse_args(["-w", "-5", "doc.md"]).source
    == Invalid("width must be positive: -5")
}

test "the long spelling of a flag is the short one" {
  # `walk` has an arm per spelling, and only a test keeps the two of a
  # pair agreeing about what they set.
  assert cli.parse_args(["--help"]).source == ShowHelp
  assert cli.parse_args(["-v"]).source == ShowVersion
  assert cli.parse_args(["--width", "60", "doc.md"]).width == 60
  assert cli.parse_args(["--pager", "doc.md"]).pager == "always"
  assert cli.parse_args(["-P", "doc.md"]).pager == "never"
}

test "every image mode is taken and nothing else is" {
  assert cli.parse_args(["--images", "auto", "doc.md"]).images == "auto"
  assert cli.parse_args(["--images", "kitty", "doc.md"]).images == "kitty"
  assert cli.parse_args(["--images", "iterm", "doc.md"]).images == "iterm"
  assert cli.parse_args(["--images", "never", "doc.md"]).images == "never"
  assert cli.parse_args(["--images", "ascii"]).source
    == Invalid("unknown image mode: ascii (auto|kitty|iterm|never)")
  assert cli.parse_args(["--style", "dark", "doc.md"]).style == "dark"
  assert cli.parse_args(["--style", "light", "doc.md"]).style == "light"
  assert cli.parse_args(["--style", "auto", "doc.md"]).style == "auto"
  # Every colour mode, for the same reason: each is its own comparison
  # and only the one a test names is read.
  assert cli.parse_args(["--color", "auto", "doc.md"]).color == "auto"
  assert cli.parse_args(["--color", "always", "doc.md"]).color == "always"
  assert cli.parse_args(["--color", "never", "doc.md"]).color == "never"
  assert cli.parse_args(["--color", "maybe"]).source
    == Invalid("unknown colour mode: maybe (auto|always|never)")
}

test "the help names every flag the parser takes" {
  # The help is all the documentation a user gets, so a flag added
  # without a line here is a flag nobody finds.
  let h = cli.help_text()
  let flags = [
    "-h", "--help", "-v", "--version", "-w", "--width", "-s", "--style", "--color",
    "--images", "-p", "--pager", "-P", "--no-pager"
  ]
  assert all(flags, f => char_index_of(h, f) != None)
}

fn main() : Int = 0
