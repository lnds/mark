import mark.parser
import mark.ast

# An ordinary list item: no task box, just its blocks.
fn li(bs: [ast.Block]) : ast.Item = ast.Item { task: None, blocks: bs }

test "headings by level, with an optional closing run" {
  assert parser.parse("# Hello") == [Heading(1, [Text("Hello")])]
  assert parser.parse("### Three") == [Heading(3, [Text("Three")])]
  assert parser.parse("## With a close ##") == [Heading(2, [Text("With a close")])]
  assert parser.parse("####### Seven") == [Para([Text("####### Seven")])]
  assert parser.parse("#hashtag") == [Para([Text("#hashtag")])]
}

test "paragraphs: adjacent lines join, a blank line cuts" {
  assert parser.parse("one\ntwo") == [Para([Text("one two")])]
  assert parser.parse("one\n\ntwo") == [Para([Text("one")]), Para([Text("two")])]
}

test "horizontal rule and its ambiguity with a bullet" {
  assert parser.parse("---") == [Rule]
  assert parser.parse("***") == [Rule]
  assert parser.parse("- - -") == [Rule]
  assert parser.parse("--") == [Para([Text("--")])]
}

test "setext headings, and the rule they are ambiguous with" {
  assert parser.parse("Title\n=====") == [Heading(1, [Text("Title")])]
  assert parser.parse("Title\n-----") == [Heading(2, [Text("Title")])]
  assert parser.parse("Two\nlines\n===") == [Heading(1, [Text("Two lines")])]
  # A single `-` underlines; three on their own are still a rule.
  assert parser.parse("Title\n-") == [Heading(2, [Text("Title")])]
  assert parser.parse("---") == [Rule]
  assert parser.parse("\n---") == [Rule]
  # An underline with nothing above it is text, not a heading.
  assert parser.parse("===") == [Para([Text("===")])]
  # `***` underlines nothing: it stays the rule it was.
  assert parser.parse("Title\n***") == [Para([Text("Title")]), Rule]
}

test "four spaces open a code block, except inside a paragraph" {
  assert parser.parse("    code") == [Code("", ["code"])]
  assert parser.parse("    one\n    two") == [Code("", ["one", "two"])]
  # Deeper indentation survives; only one level is stripped.
  assert parser.parse("    one\n      deep") == [Code("", ["one", "  deep"])]
  # A blank line inside is kept, one trailing it is not.
  assert parser.parse("    one\n\n    two") == [Code("", ["one", "", "two"])]
  assert parser.parse("    one\n\nafter") == [Code("", ["one"]), Para([Text("after")])]
  # Indentation does not open a block mid-paragraph: it is a lazy
  # continuation, which is why the two lines join.
  assert parser.parse("text\n    indented") == [Para([Text("text indented")])]
  # Markup inside is inert, the point of a code block.
  assert parser.parse("    # not a heading") == [Code("", ["# not a heading"])]
}

test "code block: the body stays raw" {
  let fenced = parser.parse("```kai\nlet x = 1\n# not a heading\n```")
  assert fenced == [Code("kai", ["let x = 1", "# not a heading"])]
  assert parser.parse("```\nno language\n```") == [Code("", ["no language"])]
  # The language is read off the fence after its indent and its spaces:
  # a fence may be indented by up to three columns, and the tag may sit
  # a space away from the ticks.
  assert parser.parse("  ```kai\n  let x = 1\n  ```") == [Code("kai", ["  let x = 1"])]
  assert parser.parse("``` kai\nlet x = 1\n```") == [Code("kai", ["let x = 1"])]
}

test "an unclosed fence runs to the end of the document" {
  assert parser.parse("```\nopen") == [Code("", ["open"])]
}

test "quotes, nested ones included" {
  assert parser.parse("> hi") == [Quote([Para([Text("hi")])])]
  assert parser.parse("> > inside") == [Quote([Quote([Para([Text("inside")])])])]
}

test "bullet and ordered lists" {
  let bullets = parser.parse("- one\n- two")
  assert bullets == [Bullets([li([Para([Text("one")])]), li([Para([Text("two")])])])]
  let ordered = parser.parse("1. one\n2. two")
  assert ordered == [Ordered(1, [li([Para([Text("one")])]), li([Para([Text("two")])])])]
  assert parser.parse("3) three") == [Ordered(3, [li([Para([Text("three")])])])]
  # An item may be indented, and its marker is as wide as the indent
  # plus the marker: a continuation line lines up under the text, and
  # the columns taken off it are counted from the indent. One column too
  # few leaves a space inside a block that keeps its own spacing.
  assert parser.parse(" 1. uno\n    dos\n 2. tres")
    == [Ordered(1, [li([Para([Text("uno dos")])]), li([Para([Text("tres")])])])]
  assert parser.parse(" 1. uno\n    ```\n    dos\n    ```")
    == [Ordered(1, [li([Para([Text("uno")]), Code("", ["dos"])])])]
}

test "an item takes an indented sublist" {
  let nested = parser.parse("- one\n  - nested")
  assert nested
    == [Bullets([li([Para([Text("one")]), Bullets([li([Para([Text("nested")])])])])])]
}

test "a list interrupts the preceding paragraph with no blank line" {
  let mixed = parser.parse("text\n- item")
  assert mixed == [Para([Text("text")]), Bullets([li([Para([Text("item")])])])]
}

test "tables: the delimiter row is what makes one" {
  let t = parser.parse("| a | b |\n|---|---|\n| 1 | 2 |")
  assert t
    == [
      Table(
        [[Text("a")], [Text("b")]],
        [AlignLeft, AlignLeft],
        [[[Text("1")], [Text("2")]]]
      )
    ]
  # The outer pipes are optional, and the cells are trimmed either way.
  assert parser.parse("a | b\n--|--\n1 | 2") == t
  # A header with no delimiter under it is a paragraph, pipes and all.
  assert parser.parse("| a | b |") == [Para([Text("| a | b |")])]
  # So is a delimiter row whose column count disagrees with the header.
  let ragged = parser.parse("| a | b |\n|---|")
  assert ragged == [Para([Text("| a | b | |---|")])]
}

test "tables: alignment, ragged rows and escaped pipes" {
  let head = [[Text("a")], [Text("b")], [Text("c")]]
  assert parser.parse("| a | b | c |\n|:--|:-:|--:|\n| 1 | 2 | 3 |")
    == [
      Table(
        head,
        [AlignLeft, AlignCenter, AlignRight],
        [[[Text("1")], [Text("2")], [Text("3")]]]
      )
    ]

  # A short row is filled out and a long one is cut, so every row has
  # exactly the columns the header declared.
  assert parser.parse("| a | b |\n|---|---|\n| 1 |\n| 1 | 2 | 3 |")
    == [
      Table(
        [[Text("a")], [Text("b")]],
        [AlignLeft, AlignLeft],
        [[[Text("1")], []], [[Text("1")], [Text("2")]]]
      )
    ]

  # An escaped pipe stays inside its cell and loses the backslash.
  assert parser.parse("| a | b |\n|---|---|\n| x \\| y | 2 |")
    == [
      Table(
        [[Text("a")], [Text("b")]],
        [AlignLeft, AlignLeft],
        [[[Text("x | y")], [Text("2")]]]
      )
    ]
}

test "a setext underline does not open a one-column table" {
  assert parser.parse("Title\n-----") == [Heading(2, [Text("Title")])]
  assert parser.parse("Title\n:---:") == [Para([Text("Title :---:")])]
}

test "blocks carry their content already scanned into inline nodes" {
  assert parser.parse("# A *title*") == [Heading(1, [Text("A "), Emph([Text("title")])])]
  let quoted = parser.parse("> with `code`")
  assert quoted == [Quote([Para([Text("with "), CodeSpan("code")])])]
}

fn main() : Int = 0

test "front matter is metadata, not a heading over a rule" {
  let d = parser.parse("---\ntitle: x\n---\n\n# Real")
  assert d == [Heading(1, [Text("Real")])]
  # With nothing to close it, the `---` was only ever a rule.
  assert parser.parse("---\nloose") == [Rule, Para([Text("loose")])]
}

test "a reference finds its definition, wherever the definition sits" {
  let back = parser.parse("see [the docs][d]\n\n[d]: https://example.org")
  assert back == [Para([Text("see "), Link([Text("the docs")], "https://example.org")])]
  # The label may carry the reference on its own, in either case.
  let collapsed = parser.parse("[Docs][]\n\n[docs]: https://example.org")
  assert collapsed == [Para([Link([Text("Docs")], "https://example.org")])]
  let shortcut = parser.parse("[docs]\n\n[docs]: https://example.org")
  assert shortcut == [Para([Link([Text("docs")], "https://example.org")])]
}

test "a reference with no definition keeps its brackets" {
  assert parser.parse("[nope]") == [Para([Text("["), Text("nope"), Text("]")])]
}

test "a definition inside a fence is code, not a definition" {
  let d = parser.parse("```\n[x]: https://example.org\n```\n\n[x]")
  assert d
    == [
      Code("", ["[x]: https://example.org"]),
      Para([Text("["), Text("x"), Text("]")])
    ]
}

test "task boxes belong to the item, and a list may mix them" {
  let d = parser.parse("- [ ] todo\n- [x] done\n- plain")
  assert d
    == [
      Bullets([
        ast.Item { task: Some(false), blocks: [Para([Text("todo")])] },
        ast.Item { task: Some(true), blocks: [Para([Text("done")])] },
        li([Para([Text("plain")])])
      ])
    ]
}

test "two trailing spaces are a break the wrap may not undo" {
  assert parser.parse("one  \ntwo") == [Para([Text("one"), Break, Text("two")])]
  assert parser.parse("one\\\ntwo") == [Para([Text("one"), Break, Text("two")])]
  # One trailing space is not two: the lines still join.
  assert parser.parse("one \ntwo") == [Para([Text("one two")])]
}

test "an image reference resolves, or keeps its bang and brackets" {
  let found = parser.parse("![pic][p]\n\n[p]: a.png")
  assert found == [Para([Image([Text("pic")], "a.png")])]
  assert parser.parse("![pic][p]") == [Para([Text("!["), Text("pic"), Text("]")])]
}

fn note(n: Int, bs: [ast.Block]) : ast.Note = ast.Note { number: n, blocks: bs }

test "a footnote is numbered by where its marker is, not where it is written" {
  let d = parser.parse("uno[^b] dos[^a]\n\n[^a]: A.\n[^b]: B.")
  assert d
    == [
      Para([Text("uno"), NoteMark(1), Text(" dos"), NoteMark(2)]),
      Notes([note(1, [Para([Text("B.")])]), note(2, [Para([Text("A.")])])])
    ]
}

test "the same marker twice is the same number, and the note appears once" {
  let d = parser.parse("a[^x] b[^x]\n\n[^x]: X.")
  assert d
    == [
      Para([Text("a"), NoteMark(1), Text(" b"), NoteMark(1)]),
      Notes([note(1, [Para([Text("X.")])])])
    ]
}

test "a marker is numbered wherever it is nested" {
  # Two walks have to cover the same ground: the one that collects the
  # markers in the order they are cited, and the one that replaces them
  # with their number. A node either of them skips leaves the marker as
  # brackets, or drops a note nobody cites.
  let d = parser.parse("**a[^b]** ~~c[^s]~~\n\n[^b]: B.\n[^s]: S.")
  assert d
    == [
      Para([Strong([Text("a"), NoteMark(1)]), Text(" "), Strike([Text("c"), NoteMark(2)])]),
      Notes([note(1, [Para([Text("B.")])]), note(2, [Para([Text("S.")])])])
    ]
}

test "a marker nothing defines keeps its brackets, and defines no section" {
  assert parser.parse("a[^nope]") == [Para([Text("a"), Text("[^nope]")])]
}

test "a note nothing cites is not shown" {
  assert parser.parse("plain\n\n[^x]: X.") == [Para([Text("plain")])]
}

test "a note holds blocks, not just a line" {
  let d = parser.parse("a[^x]\n\n[^x]: One.\n\n    Two.")
  assert d
    == [
      Para([Text("a"), NoteMark(1)]),
      Notes([note(1, [Para([Text("One.")]), Para([Text("Two.")])])])
    ]
}

test "a footnote definition is not a link definition" {
  # `[^1]: text` used to be read as a reference whose destination was
  # the first word of the note.
  let d = parser.parse("a[^1] b[c]\n\n[^1]: La primera nota.\n[c]: https://x.example")
  assert d
    == [
      Para([Text("a"), NoteMark(1), Text(" b"), Link([Text("c")], "https://x.example")]),
      Notes([note(1, [Para([Text("La primera nota.")])])])
    ]
}

test "markers inside a quote or a list are found too" {
  let d = parser.parse("> q[^x]\n\n[^x]: X.")
  assert d
    == [
      Quote([Para([Text("q"), NoteMark(1)])]),
      Notes([note(1, [Para([Text("X.")])])])
    ]
}

test "a definition inside a fence is code, footnotes included" {
  let d = parser.parse("```\n[^x]: not a note\n```\n\na[^x]")
  assert d == [Code("", ["[^x]: not a note"]), Para([Text("a"), Text("[^x]")])]
}

test "a footnote marker is found and numbered wherever it nests" {
  # `marks_of` and `mark_one` walk into emphasis, link labels and alt
  # text; a marker there has to be numbered like any other.
  let emph = parser.parse("*nota[^a]*\n\n[^a]: A.")
  assert emph
    == [
      Para([Emph([Text("nota"), NoteMark(1)])]),
      Notes([note(1, [Para([Text("A.")])])])
    ]
  let inlink = parser.parse("[texto[^a]](https://x.example)\n\n[^a]: A.")
  assert inlink
    == [
      Para([Link([Text("texto"), NoteMark(1)], "https://x.example")]),
      Notes([note(1, [Para([Text("A.")])])])
    ]
  let inalt = parser.parse("![alt[^a]](p.png)\n\n[^a]: A.")
  assert inalt
    == [
      Para([Image([Text("alt"), NoteMark(1)], "p.png")]),
      Notes([note(1, [Para([Text("A.")])])])
    ]
}

test "a reference resolves wherever it nests, too" {
  # `resolve_one` has the same arms, and each needs its own case.
  assert parser.parse("*[r]*\n\n[r]: https://x.example")
    == [Para([Emph([Link([Text("r")], "https://x.example")])])]
  assert parser.parse("**[r]**\n\n[r]: https://x.example")
    == [Para([Strong([Link([Text("r")], "https://x.example")])])]
  assert parser.parse("~~[r]~~\n\n[r]: https://x.example")
    == [Para([Strike([Link([Text("r")], "https://x.example")])])]
  # A label is itself a place a reference can sit, in a link and in an
  # image: one left unresolved shows up as brackets inside the text.
  assert parser.parse("[see [r]](u)\n\n[r]: https://x.example")
    == [Para([Link([Text("see "), Link([Text("r")], "https://x.example")], "u")])]
  assert parser.parse("![alt [r]](p.png)\n\n[r]: https://x.example")
    == [Para([Image([Text("alt "), Link([Text("r")], "https://x.example")], "p.png")])]
}

test "an ordered list and a quote carry markers like any other container" {
  # `marks_of`, `mark_block` and `resolve_block` each have an `Ordered`
  # arm and a `Quote` arm that the bullet-only tests never reach.
  let ord = parser.parse("1. uno[^a]\n\n[^a]: A.")
  assert ord
    == [
      Ordered(1, [li([Para([Text("uno"), NoteMark(1)])])]),
      Notes([note(1, [Para([Text("A.")])])])
    ]
  assert parser.parse("> cita [r]\n\n[r]: https://x.example")
    == [Quote([Para([Text("cita "), Link([Text("r")], "https://x.example")])])]
  assert parser.parse("1. [r]\n\n[r]: https://x.example")
    == [Ordered(1, [li([Para([Link([Text("r")], "https://x.example")])])])]
}

test "the space around a block's markers is not part of its text" {
  # Each of these has a `trim` that no test depended on: indent before a
  # marker, space after it, space before a closing run.
  assert parser.parse("   ## Title  ##  ") == [Heading(2, [Text("Title")])]
  assert parser.parse("  > quoted") == [Quote([Para([Text("quoted")])])]
  assert parser.parse("   1. one") == [Ordered(1, [li([Para([Text("one")])])])]
  # A quote keeps one space off the bar, and no more than one.
  assert parser.parse(">   wide") == [Quote([Para([Text("wide")])])]
}

test "a front matter fence may carry trailing space" {
  # `strip_front_matter` trims each line before comparing it, so a fence
  # with a space after it still closes the block.
  assert parser.parse("---  \ntitle: x\n---  \n\n# Real") == [Heading(1, [Text("Real")])]
  assert parser.parse("+++\ntitle = 'x'\n+++  \n\n# Real") == [Heading(1, [Text("Real")])]
}

test "a definition's label and destination are trimmed" {
  # `defined_at` trims both sides, and an empty one on either is no
  # definition at all.
  assert parser.parse("[r]\n\n[ r ]:   https://x.example  ")
    == [Para([Link([Text("r")], "https://x.example")])]
  # A label of blanks is no label, so neither is it a definition: the
  # line is the paragraph it reads as.
  assert parser.parse("[a]: /x") == []
  assert parser.parse("[ ]: /x") != []
  # An empty destination defines nothing, so the line stays content and
  # the reference above it keeps its brackets.
  assert parser.parse("[r]\n\n[r]:   ")
    == [
      Para([Text("["), Text("r"), Text("]")]),
      Para([Text("["), Text("r"), Text("]"), Text(":")])
    ]
}

test "a tab opens indented code as four spaces do" {
  assert parser.parse("\tcodigo") == [Code("", ["codigo"])]
  # A blank line inside the block belongs to it; the ones trailing do not.
  assert parser.parse("    uno\n\n    dos") == [Code("", ["uno", "", "dos"])]
  assert parser.parse("    uno\n\ntexto") == [Code("", ["uno"]), Para([Text("texto")])]
}

test "a note ends where its indentation does" {
  let d = parser.parse("t[^1]\n\n[^1]: a\n\n    b\n\nfuera")
  assert d
    == [
      Para([Text("t"), NoteMark(1)]),
      Para([Text("fuera")]),
      Notes([note(1, [Para([Text("a")]), Para([Text("b")])])])
    ]
}

test "a setext underline of equals titles level one" {
  assert parser.parse("T\n===") == [Heading(1, [Text("T")])]
  assert parser.parse("T\n---") == [Heading(2, [Text("T")])]
}

test "a paragraph is interrupted by every block that may follow it" {
  # `interrupts_para` names six shapes and each has to be the one that
  # ends the paragraph, with no blank line between them.
  assert parser.parse("texto\n# T") == [Para([Text("texto")]), Heading(1, [Text("T")])]
  assert parser.parse("texto\n```\nx\n```")
    == [Para([Text("texto")]), Code("", ["x"])]
  assert parser.parse("texto\n> q")
    == [Para([Text("texto")]), Quote([Para([Text("q")])])]
  assert parser.parse("texto\n***") == [Para([Text("texto")]), Rule]
  assert parser.parse("texto\n1. uno")
    == [Para([Text("texto")]), Ordered(1, [li([Para([Text("uno")])])])]
  # Three dashes with something after them are not a rule, so the
  # paragraph swallows the line.
  assert parser.parse("texto\n---x") == [Para([Text("texto ---x")])]
}

test "an ordered list counts its marker's digits, however many" {
  let d = parser.parse("10. diez\n11. once")
  assert d
    == [Ordered(10, [li([Para([Text("diez")])]), li([Para([Text("once")])])])]
  # The continuation lines up past a two-digit marker.
  assert parser.parse("10. aaa\n    bbb") == [Ordered(10, [li([Para([Text("aaa bbb")])])])]
}

test "a tilde fence opens a code block as a backtick one does" {
  # `fence_marker` names both spellings, and a fence closes only with
  # the character that opened it.
  assert parser.parse("~~~\nno language\n~~~") == [Code("", ["no language"])]
  assert parser.parse("~~~kai\nlet x = 1\n~~~") == [Code("kai", ["let x = 1"])]
  assert parser.parse("~~~\n```\n~~~") == [Code("", ["```"])]
}

test "every bullet marker opens the same list" {
  # `bullet_marker` names three and only `-` was exercised.
  let one = [Bullets([li([Para([Text("uno")])])])]
  assert parser.parse("- uno") == one
  assert parser.parse("* uno") == one
  assert parser.parse("+ uno") == one
  # The marker needs its space: `*uno*` is emphasis, not a list.
  assert parser.parse("*uno*") == [Para([Emph([Text("uno")])])]
}

test "a definition's title is dropped and its destination kept" {
  # `first_word` cuts the destination at the space, so whatever follows
  # it is a title and says nothing the label has not said.
  assert parser.parse("[x]: https://example.org \"El titulo\"\n\n[x]")
    == [Para([Link([Text("x")], "https://example.org")])]
}

test "pipes alone do not open a table" {
  # `delimiter_row` turns down a line that carries pipes but whose cells
  # are not delimiters, which is what keeps a table out of a paragraph.
  assert parser.parse("| a | b |\n| c | d |") == [Para([Text("| a | b | | c | d |")])]
}

test "an empty document parses to no blocks at all" {
  assert parser.parse("") == []
}

test "a footnote with no label is not a footnote" {
  # `noted_at` turns down an empty label, so the line is left to the
  # passes below — where `[^]: nada` is read as a link definition that
  # nothing cites, and a definition renders as nothing.
  assert parser.parse("[^]: nada") == []
}

test "a note's body ends at the blank line that ends the document" {
  # `note_body` stops at a blank line with nothing indented under it,
  # and at the end of the document there is nothing under it at all.
  let one = [Para([Text("a"), NoteMark(1)]), Notes([note(1, [Para([Text("N.")])])])]
  assert parser.parse("a[^1]\n\n[^1]: N.\n") == one
  # The blank line is the last line of the document: nothing follows it
  # to say whether the note went on.
  assert parser.parse("a[^1]\n\n[^1]: N.\n\n") == one
  # What follows unindented ends the note and is a block of its own,
  # which still comes above the notes at the foot.
  assert parser.parse("a[^1]\n\n[^1]: N.\n\nfin")
    == [Para([Text("a"), NoteMark(1)]), Para([Text("fin")]), Notes([note(1, [Para([Text("N.")])])])]
}
