import mark.image
import array
import bin
import encoding.base64
import terevaka.ui as ui

# "Man" — three bytes whose base64 is the textbook `TWFu`, with no
# padding, so a wrong alphabet or a stray `=` shows up immediately.
fn man() : Array[Byte] = array.from([bin.byte(77), bin.byte(97), bin.byte(110)])

# The eight bytes a PNG opens with. kitty takes PNG and nothing else, so
# a buffer it will accept has to start with them.
fn png_magic() : [Int] = [137, 80, 78, 71, 13, 10, 26, 10]

fn png_of(extra: [Int]) : Array[Byte] = array.from((png_magic() ++ extra) | (n => bin.byte(n)))

# Long enough to need two chunks: 3073 bytes base64-encode to 4100
# characters, four past the protocol's cap.
fn long() : Array[Byte] = png_of(list.repeat(65, 3065))

fn esc() : String = "\u{1b}"

test "a protocol that draws nothing returns nothing" {
  assert image.sequence(NoImages, man()) == None
}

test "iTerm2 takes the payload whole, with the decoded length" {
  assert image.sequence(Iterm, man())
    == Some("#{esc()}]1337;File=inline=1;size=3:TWFu\u{7}")
}

test "kitty transmits and displays in one chunk when it fits" {
  assert image.sequence(Kitty, png_of([77, 97, 110]))
    == Some("#{esc()}_Ga=T,f=100,m=0;iVBORw0KGgpNYW4=#{esc()}\\")
}

test "kitty refuses what is not a PNG rather than mislabelling it" {
  # `f=100` says PNG. Sending JPEG bytes under it is a lie the terminal
  # cannot catch and the reader sees as nothing at all.
  assert image.sequence(Kitty, array.from([255, 216, 255, 224] | (n => bin.byte(n)))) == None
  assert image.sequence(Kitty, man()) == None
  # iTerm2 takes whatever the system can open, so the same bytes are fine.
  assert image.sequence(Iterm, man()) != None
}

test "kitty chunks at the protocol's cap, and only the last says it ends" {
  match image.sequence(Kitty, long()) {
    None -> {
      assert false
    }
    Some(seq) -> {
      # Two chunks: the opener carries the format and `m=1` for "more
      # follows", the closer carries `m=0` and no format.
      assert char_index_of(seq, "#{esc()}_Ga=T,f=100,m=1;") == Some(0)
      assert char_index_of(seq, "m=0;") != None
      # 4100 base64 characters split 4096 + 4, plus the two envelopes.
      assert length(chars(seq))
        == 4100
          + length(chars("#{esc()}_Ga=T,f=100,m=1;#{esc()}\\"))
          + length(chars("#{esc()}_Gm=0;#{esc()}\\"))
    }
  }
}

test "the payload survives the encoder untouched" {
  match image.sequence(Kitty, long()) {
    None -> {
      assert false
    }
    Some(seq) -> {
      let body = replace(replace(seq, "#{esc()}_Ga=T,f=100,m=1;", ""), "#{esc()}_Gm=0;", "")
      let joined = replace(body, "#{esc()}\\", "")
      assert base64.decode(joined) != None
      assert length(chars(joined)) == 4100
    }
  }
}

# A PNG header: signature, then the IHDR length and tag, then width and
# height big-endian. Nothing after them is read, so nothing follows.
fn png_header(w: Int, h: Int) : Array[Byte] = array.from(
  ([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82]
    ++ be32(w)
    ++ be32(h))
    | (n => bin.byte(n))
)

fn be32(n: Int) : [Int] = [n / 16777216 % 256, n / 65536 % 256, n / 256 % 256, n % 256]

fn size_is(got: Option[(Int, Int)], w: Int, h: Int) : Bool = match got {
  Some(p) -> p.fst == w and p.snd == h
  None -> false
}

test "a PNG says its size in the header it opens with" {
  assert size_is(image.png_size(png_header(320, 120)), 320, 120)
  assert size_is(image.png_size(png_header(1, 1)), 1, 1)
  # Not a PNG, or too short to hold a header: no size to be had.
  assert is_none(image.png_size(array.from([bin.byte(1), bin.byte(2)])))
  assert is_none(image.png_size(png_header(0, 0)))
  # Either side at nought is no size: a picture with one of them missing
  # cannot be scaled, and half a size is worse than none.
  assert is_none(image.png_size(png_header(320, 0)))
  assert is_none(image.png_size(png_header(0, 120)))
}

fn cells_are(w: Int, h: Int, cw: Int, ch: Int, cols: Int, rows: Int) : Bool {
  let got = image.cells_for(w, h, cw, ch)
  got.fst == cols and got.snd == rows
}

test "pixels become cells, rounded up so nothing is cut" {
  # The real measurement from a Retina terminal: 23 x 48 px per cell.
  assert cells_are(320, 120, 23, 48, 14, 3)
  assert cells_are(160, 160, 23, 48, 7, 4)
  # An exact fit does not gain a row it does not need.
  assert cells_are(46, 96, 23, 48, 2, 2)
  # Nothing ever measures zero.
  assert cells_are(1, 1, 23, 48, 1, 1)
}

test "the placeholder grid is as wide as it claims to be" {
  let g = image.grid(7, 14, 3)
  assert length(g) == 3
  # What the pager will measure: 14 columns on every line. `visible_len`
  # is the one that discounts the escape codes; `text.display_width`
  # counts their bytes and would say 30-odd.
  assert all(g, l => ui.visible_len(l) == 14)
}

test "only the first cell of a line carries its row" {
  let g = image.grid(7, 4, 2)
  # Row 0 takes the first diacritic of kitty's table, row 1 the second.
  assert char_index_of(nth(g, 0) ?? "", "\u{0305}") != None
  assert char_index_of(nth(g, 1) ?? "", "\u{030D}") != None
  # Four cells, one diacritic: the other three inherit the row.
  assert count(chars(nth(g, 0) ?? ""), c => c == '\u{10eeee}') == 4
  assert count(chars(nth(g, 0) ?? ""), c => c == '\u{305}') == 1
}

test "the image id rides in the foreground colour" {
  let g = image.grid(4100, 2, 1)
  # 4100 is 0x001004: no red, 0x10 green, 0x04 blue.
  assert char_index_of(nth(g, 0) ?? "", "[38;2;0;16;4m") != None
}

test "a placed image draws through its placeholders, not a sequence" {
  assert image.sequence(Placed(23, 48), man()) == None
}

fn tile(cols: Int, rows: Int, ch: Char) : ([String], Int) =
  ([0..(rows - 1)] | (r => from_chars(list.repeat(ch, cols))), cols)

test "tiles sit side by side, with a column between them" {
  let b = image.bands([tile(3, 2, 'a'), tile(4, 2, 'b')], 40)
  assert b == ["aaa bbbb", "aaa bbbb"]
}

test "a band is as tall as its tallest tile, the rest padded" {
  let b = image.bands([tile(2, 1, 'a'), tile(3, 3, 'b')], 40)
  # The short tile keeps its columns as blanks so the next one still
  # starts where it should.
  assert b == ["aa bbb", "   bbb", "   bbb"]
}

test "a row of tiles wraps instead of running off the edge" {
  # Three tiles of 4 columns need 14 with the gaps; 10 fits only two.
  let b = image.bands([tile(4, 1, 'a'), tile(4, 1, 'b'), tile(4, 1, 'c')], 10)
  assert b == ["aaaa bbbb", "cccc"]
}

test "a tile wider than the width still gets its own band" {
  let b = image.bands([tile(20, 1, 'a'), tile(2, 1, 'b')], 10)
  assert b == ["aaaaaaaaaaaaaaaaaaaa", "bb"]
}

test "no tiles, no lines" {
  assert image.bands([], 40) == []
  # A tile that drew nothing takes no line either, rather than a band of
  # blanks where a picture was meant to be.
  assert image.bands([([], 3)], 40) == []
}

test "a band takes the column between its tiles into account" {
  # Two tiles of 4 and 5 columns need ten with the column between them,
  # which is the boundary `pack` turns on: at ten they share a band and
  # at nine they cannot.
  assert image.bands([tile(4, 1, 'a'), tile(5, 1, 'b')], 10) == ["aaaa bbbbb"]
  assert image.bands([tile(4, 1, 'a'), tile(5, 1, 'b')], 9) == ["aaaa", "bbbbb"]
}

fn head_of(bs: [Int]) : Array[Byte] = array.from(bs | (n => bin.byte(n)))

test "a format is judged by the bytes it opens with, not its name" {
  assert image.format_of(head_of([137, 80, 78, 71, 13, 10, 26, 10, 0, 0])) == Png
  assert image.format_of(head_of([255, 216, 255, 224])) == Jpeg
  assert image.format_of(head_of([71, 73, 70, 56, 57, 97])) == Gif
  assert image.format_of(head_of([82, 73, 70, 70, 1, 2, 3, 4, 87, 69, 66, 80])) == Webp
  assert image.format_of(head_of([66, 77, 1, 2])) == Bmp
  # RIFF that is not WebP — a wav, say — is not an image we know.
  assert image.format_of(head_of([82, 73, 70, 70, 1, 2, 3, 4, 87, 65, 86, 69])) == Other
  # Too short to carry any signature at all.
  assert image.format_of(head_of([137, 80])) == Other
  assert image.format_of(array.from([])) == Other
}

test "a kitty sequence may name the file instead of spelling it out" {
  # The path travels in place of the bytes, which is what makes a 3.5 MB
  # picture cost what a small one costs.
  let named = base64.encode(chars("/tmp/x.png") | char_to_int)
  assert image.sequence_path(Kitty, "/tmp/x.png", false)
    == Some("#{esc()}_Ga=T,f=100,t=f,q=2;#{named}#{esc()}\\")
  # `t=t` says the file was made for this and may be deleted once read.
  assert image.sequence_path(Kitty, "/tmp/x.png", true)
    == Some("#{esc()}_Ga=T,f=100,t=t,q=2;#{named}#{esc()}\\")
  # Nothing else can point at a file: iTerm2's protocol carries the data.
  assert image.sequence_path(Iterm, "/tmp/x.png", false) == None
  assert image.sequence_path(Placed(8, 16), "/tmp/x.png", false) == None
  assert image.sequence_path(NoImages, "/tmp/x.png", false) == None
}

test "a mode said out loud is taken without asking the terminal" {
  # `named` is the half of `detect` that needs no terminal: the modes
  # that are their own answer, which is what makes `--images` a way out
  # of a bad guess. `auto` is the one that has to ask.
  assert image.named("never") == Some(NoImages)
  assert image.named("none") == Some(NoImages)
  assert image.named("kitty") == Some(Kitty)
  assert image.named("iterm") == Some(Iterm)
  assert image.named("auto") == None
  assert image.named("") == None
  # And `detect` answers with it, rather than asking anyway.
  assert image.detect("kitty") == Kitty
  assert image.detect("iterm") == Iterm
  assert image.detect("never") == NoImages
}

test "a cell's size is read rows first, and comes back width first" {
  # `CSI 6 ; height ; width t` is the answer, and `term.probe` hands it
  # over without the `t` it ended on. A cell is (width, height), so the
  # pair comes back the other way round from how the terminal said it.
  assert image.measured("#{esc()}[6;34;15") == Some((15, 34))
  # A terminal that answers nothing usable gets no size invented for it.
  assert image.measured("#{esc()}[6;0;15") == None
  assert image.measured("#{esc()}[6;34;0") == None
  # One pixel is a cell size; nought is the answer that means nothing.
  assert image.measured("#{esc()}[6;1;1") == Some((1, 1))
  assert image.measured("#{esc()}[6;alto;15") == None
  assert image.measured("#{esc()}[6") == None
  assert image.measured("") == None
}

test "the diacritics table is kitty's, entry for entry" {
  # The combining character at index n is what tells the terminal which
  # row of the image a placeholder cell belongs to, so a single wrong
  # entry scrambles the picture instead of losing it. A table of 297
  # constants cannot be read by eye, so it is pinned by what a wrong
  # value breaks: its length, its order, its ends, and its sum — the
  # last being the only one a swapped digit cannot survive.
  let ds = image.diacritics()
  assert length(ds) == 297
  assert image.max_rows() == 297
  assert sum(ds) == 4545336
  # Protocol order, which is also ascending: no duplicate can hide in it.
  assert all(enumerate(drop(ds, 1)), p => p.snd > (nth(ds, p.fst) ?? 0))
  assert head(ds) == Some(0x0305)
  assert last(ds) == Some(0x1D244)
}
