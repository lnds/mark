import mark.pager
import terevaka.term as term
import terevaka.term.{Down, Enter, Esc, Printable, Tick, Up}
import terevaka.ui as ui

fn doc(n: Int) : [String] = [0..(n - 1)] | (i => "L#{i}")

# 10 lines in a 5-row screen: 4 of body and one of status.
fn m5() : pager.Model = pager.model(doc(10), 5, "doc.md")

test "the window starts at the top and shows only what fits" {
  assert pager.viewport(m5()) == ["L0", "L1", "L2", "L3"]
}

test "scrolling moves the window" {
  assert pager.viewport(pager.scroll(m5(), 2)) == ["L2", "L3", "L4", "L5"]
  let page = pager.scroll(m5(), 4)
  assert pager.viewport(page) == ["L4", "L5", "L6", "L7"]
}

test "the window never leaves the document at either end" {
  assert pager.scroll(m5(), 0 - 3).top == 0
  # The ceiling leaves the last line at the foot, not mid-empty-screen.
  assert pager.scroll(m5(), 999).top == 6
  assert pager.viewport(pager.scroll(m5(), 999)) == ["L6", "L7", "L8", "L9"]
}

test "a document shorter than the screen is padded and does not move" {
  let short = pager.model(["a", "b"], 5, "short.md")
  assert pager.viewport(short) == ["a", "b", "", ""]
  assert pager.scroll(short, 5).top == 0
}

test "the keys do what the help says" {
  let m = m5()
  assert pager.step(m, Printable('q')) == None
  assert pager.step(m, Esc) == None
  assert pager.step(m, Printable('j')) == Some(pager.scroll(m, 1))
  assert pager.step(m, Down) == Some(pager.scroll(m, 1))
  assert pager.step(m, Printable(' ')) == Some(pager.scroll(m, 4))
  assert pager.step(m, Printable('G')) == Some(pager.scroll(m, 999))
  assert pager.step(m, Printable('k')) == Some(m)
  assert pager.step(m, Tick) == Some(m)
}

# The terevaka frame paints from row 2, column 4: a frame using the full
# height or width overflows, the terminal wraps, and the resulting
# scroll shifts the whole frame.
test "the frame leaves room for the frame margin" {
  assert pager.body_rows(30) == 28
  assert pager.body_rows(3) == 1
  assert pager.body_rows(1) == 1
  let m = pager.model(doc(100), pager.body_rows(30) + 1, "x.md")
  assert pager.viewport(m).length() == 28
  assert ui.visible_len(pager.status(m, 100 - pager.margin())) == 97
}

# The bar is measured in columns, not bytes: the ellipsis of a cut takes
# one column and three bytes.
test "the status bar occupies exactly the width given" {
  assert ui.visible_len(pager.status(m5(), 40)) == 40
  assert ui.visible_len(pager.status(m5(), 12)) == 12
  assert ui.visible_len(pager.status(m5(), 100)) == 100
}

test "the keys show up only when there is room to spare" {
  assert pager.status(m5(), 12) == "doc.md  4/1…"
  let wide = pager.status(m5(), 100)
  assert index_of(wide, "q quit") != None
  assert index_of(pager.status(m5(), 40), "q quit") == None
}

test "a screen of one row still has a row of body" {
  # `rows - 1` hands one row to the status bar; what is left has to be a
  # row of body, or the pager opens on an empty screen.
  let tiny = pager.model(doc(3), 1, "t.md")
  assert tiny.height == 1
  assert pager.viewport(tiny) == ["L0"]
}

test "the bar says how far down the document the window is" {
  let m = m5()
  assert index_of(pager.status(m, 100), " 4/10  0%") != None
  assert index_of(pager.status(pager.scroll(m, 3), 100), " 7/10  50%") != None
  assert index_of(pager.status(pager.scroll(m, 999), 100), " 10/10  100%") != None
  # A document with nowhere to scroll is read in full from the start.
  assert index_of(pager.status(pager.model(["a"], 5, "s.md"), 100), " 1/1  100%") != None
  # One line past the screen scrolls by one, and starts at nought: a
  # ceiling mistaken for no ceiling at all would say 100 here.
  assert index_of(pager.status(pager.model(doc(5), 5, "x.md"), 100), " 4/5  0%") != None
}

test "the keys appear the moment the bar has room, and not a column sooner" {
  let left = "doc.md  4/10  0%"
  let keys = "j/k up/down scroll · space/b page · g/G ends · q quit"
  # Room to spare means at least the two columns that separate them.
  let exact = ui.visible_len(left) + ui.visible_len(keys) + 2
  assert pager.status(m5(), exact) == "#{left}  #{keys}"
  assert index_of(pager.status(m5(), exact - 1), "q quit") == None
}

fn main() : Int = 0

# Where a key leaves the window, as a line number rather than as another
# call to `scroll`: comparing one call against another says nothing when
# the clamp makes both land in the same place.
fn top_after(m: pager.Model, k: term.Key) : Int = match pager.step(m, k) {
  Some(next) -> next.top
  None -> 0 - 1
}

test "every key moves the window by the distance it names" {
  # Ten lines in four rows of body, so the window runs from 0 to 6.
  let top = m5()
  let foot = pager.scroll(top, 999)
  assert foot.top == 6
  # Down by one, by a page, by half a page — from the top, where only
  # the downward keys have anywhere to go.
  assert top_after(top, Printable('j')) == 1
  assert top_after(top, Down) == 1
  assert top_after(top, Enter) == 1
  assert top_after(top, Printable(' ')) == 4
  assert top_after(top, Printable('f')) == 4
  assert top_after(top, Printable('d')) == 2
  assert top_after(top, Printable('G')) == 6
  # The same keys upward, from the foot: at the top they would all clamp
  # to zero and a wrong distance would look right.
  # A key that moves nothing has to be told from one that moves a line,
  # which only shows away from an end.
  assert top_after(top, Tick) == 0
  assert top_after(foot, Printable('k')) == 5
  assert top_after(foot, Up) == 5
  assert top_after(foot, Printable('b')) == 2
  assert top_after(foot, Printable('u')) == 4
  assert top_after(foot, Printable('g')) == 0
  # A key it does not know leaves the window where it was.
  assert top_after(foot, Tick) == 6
}
