import text
import mark.render
import mark.theme
import mark.parser
import mark.ast

# With the `plain` theme the output is layout alone: line breaking and
# indentation get checked with no codes in the way.
fn plain(src: String, width: Int) : [String] =
  render.render(theme.plain(), width, parser.parse(src))

test "a paragraph breaks between words, never inside one" {
  assert plain("one two three four five", 20) == ["one two three four", "five"]
  assert plain("supercalifragilistic ok", 20) == ["supercalifragilistic", "ok"]
}

test "a heading keeps its hashes and aligns the continuation" {
  assert plain("## A title", 40) == ["## A title"]
  let wrapped = plain("### one two three four", 20)
  assert wrapped == ["### one two three", "    four"]
}

test "blocks are separated by a blank line" {
  assert plain("one\n\ntwo", 40) == ["one", "", "two"]
}

test "code is indented and never wrapped" {
  let out = plain("```\na very long line that is left alone\n```", 20)
  assert out == ["  a very long line that is left alone"]
}

test "a quote carries its bar on every line" {
  assert plain("> hi", 40) == ["│ hi"]
}

test "lists align the continuation under the item text" {
  assert plain("- one\n- two", 40) == ["• one", "• two"]
  assert plain("1. one\n2. two", 40) == ["1. one", "2. two"]
  assert plain("10. ten", 40) == ["10. ten"]
}

test "the rule spans the requested width" {
  assert plain("---", 24) == [repeat("─", 24)]
}

test "a link shows its destination, which would otherwise be lost" {
  assert plain("[kaikai](https://kaikai-lang.org)", 60)
    == ["kaikai (https://kaikai-lang.org)"]
}

test "a table draws its frame and honours the alignments" {
  assert plain("| ab | c |\n|:--|--:|\n| 1 | 22 |", 40)
    == [
      "┌────┬────┐",
      "│ ab │  c │",
      "├────┼────┤",
      "│ 1  │ 22 │",
      "└────┴────┘"
    ]
}

test "a table is squeezed into the width rather than overflowing it" {
  # The columns want 12 and 12 plus a 7-column frame; they get 8 each.
  assert plain("| alpha | beta |\n|---|---|\n| uno dos tres | cuatro cinco |", 24)
    == [
      "┌──────────┬──────────┐",
      "│ alpha    │ beta     │",
      "├──────────┼──────────┤",
      "│ uno dos  │ cuatro   │",
      "│ tres     │ cinco    │",
      "└──────────┴──────────┘"
    ]
}

test "every line of a table is the same width, frame included" {
  let out = plain("| a | bbbbbbbbbbbbbbbbbbbb |\n|---|--:|\n| ccc | d |", 30)
  assert all(out, l => text.display_width(l) <= 30)
  # A ragged frame is the symptom of measuring text after painting it.
  assert all(out, l => text.display_width(l) == text.display_width(head_of(out)))
}

test "a word wider than its column is cut, never dropped" {
  # `wrap` lets a long word out whole rather than splitting it, which
  # would reach past the bar. In a cell it is cut, and the tail carries
  # on down: no character is lost to make the grid.
  assert plain("| x |\n|---|\n| abcdefghijklmnopqrst |", 20)
    == [
      "┌──────────────────┐",
      "│ x                │",
      "├──────────────────┤",
      "│ abcdefghijklmnop │",
      "│ qrst             │",
      "└──────────────────┘"
    ]
}

fn head_of(ls: [String]) : String = match head(ls) {
  Some(l) -> l
  None -> ""
}

test "the theme paints and closes the style" {
  let esc = "\u{1b}"
  let out = render.render(theme.dark(), 40, parser.parse("a *fact*"))
  assert out == ["a #{esc}[3mfact#{esc}[0m"]
}

test "a word that exactly fills the line stays on it" {
  # `place` turns on `line.width + 1 + word.width <= width`, so the
  # boundary is the line that is exactly as wide as it may be.
  assert plain("aaaaaa bbbbbb cccccc", 20) == ["aaaaaa bbbbbb cccccc"]
  assert plain("aaaaaa bbbbbb ccccccd", 20) == ["aaaaaa bbbbbb", "ccccccd"]
}

test "a quote keeps its bar's two columns off the width it passes down" {
  # The `2` in the Quote arm is the bar: the inner block is wrapped to
  # eighteen, not to twenty.
  assert plain("> aaaaaa bbbbbb cccc", 20) == ["│ aaaaaa bbbbbb cccc"]
  assert plain("> aaaaaa bbbbbb ccccc", 20) == ["│ aaaaaa bbbbbb", "  ccccc"]
}

test "a table exactly at its budget keeps its columns, one past it gives" {
  # `fit_cols` turns on `sum(nat) <= avail`, and the frame costs seven
  # of the twenty: two columns of 7 and 6 fit exactly.
  let fits = plain("| aaaaaaa | bbbbbb |\n|---|---|\n| c | d |", 20)
  assert contains(fits, "│ aaaaaaa │ bbbbbb │")
  assert all(fits, l => text.display_width(l) == 20)
  # One column wider on each and they have to share what is left, so a
  # cell wraps rather than the table overflowing.
  let squeezed = plain("| aaaaaaaa | bbbbbbbb |\n|---|---|\n| c | d |", 20)
  assert all(squeezed, l => text.display_width(l) <= 20)
  assert contains(squeezed, "│ aa     │ bb     │")
}

test "a table with no room left to share keeps the columns it has" {
  # `fit_cols` gives up when `avail <= 0`: seven columns and their frame
  # need twenty-nine, so no sharing can make them fit in twenty. The
  # table is drawn whole rather than collapsed to nothing.
  let wide =
    plain("| a | b | c | d | e | f | g |\n|-|-|-|-|-|-|-|\n| 1 | 2 | 3 | 4 | 5 | 6 | 7 |", 20)
  assert contains(wide, "│ a │ b │ c │ d │ e │ f │ g │")
  assert all(wide, l => text.display_width(l) == 29)
}

test "an ordered list numbers from where the source started" {
  assert plain("1. uno\n2. dos", 20) == ["1. uno", "2. dos"]
  assert plain("3) tres", 20) == ["3. tres"]
  # The continuation lines up under the text, past the number.
  assert plain("9. aaaa bbbb cccc dddd", 20) == ["9. aaaa bbbb cccc", "   dddd"]
}

test "a task box rides after the bullet, so a mixed list still lines up" {
  assert plain("- [ ] a\n- [x] b\n- c", 20) == ["• [ ] a", "• [x] b", "• c"]
}

test "the footnotes come under a rule, numbered as the markers are" {
  assert plain("t[^1]\n\n[^1]: nota", 20)
    == ["t[1]", "", "────────────────────", "[1] nota"]
  # A note holding two paragraphs indents both under its number.
  assert plain("t[^1]\n\n[^1]: una\n\n    otra", 20)
    == [
      "t[1]", "", "────────────────────", "[1] una", "    ",
      "    otra"
    ]
}

test "strikethrough and a hard break reach the painter" {
  assert plain("~~gone~~", 20) == ["gone"]
  assert plain("a  \nb", 20) == ["a", "b"]
  assert plain("a\\\nb", 20) == ["a", "b"]
}

test "an image that cannot be drawn says what it was" {
  assert plain("![alt](p.png)", 20) == ["[alt] (p.png)"]
  assert plain("![a](x.png) ![b](y.png)", 30) == ["[a] (x.png) [b] (y.png)"]
}

test "a link whose label is its destination does not print it twice" {
  # `shows_dest` is what keeps an autolink from repeating itself.
  assert plain("<https://x.example>", 30) == ["https://x.example"]
  assert plain("<a@b.example>", 30) == ["a@b.example"]
  assert plain("[t](https://x.example)", 30) == ["t (https://x.example)"]
}

test "a picture is already lines, and goes out as it came" {
  # `main` is the only thing that builds one, since only it may read a
  # file — but the arm that emits it belongs to the renderer and is
  # testable with the block built by hand.
  let drawn = ast.Picture(["<seq-a>", "<seq-b>"], [ast.Text("alt")])
  assert render.render(theme.plain(), 20, [drawn]) == ["<seq-a>", "<seq-b>"]
  # Its lines are not wrapped, however long: they carry no columns.
  let wide = ast.Picture([repeat("x", 80)], [ast.Text("alt")])
  assert render.render(theme.plain(), 20, [wide]) == [repeat("x", 80)]
  # The alt text is not printed beside the picture.
  assert not contains(render.render(theme.plain(), 20, [drawn]), "alt")
}

test "every element the theme names gets painted and closed" {
  # One pass over the dark theme, so a style that is wired to the wrong
  # element cannot hide behind the plain one the other tests use.
  let esc = "\u{1b}"
  let th = theme.dark()
  assert render.render(th, 40, parser.parse("# T"))
    == ["#{esc}[1;36m# #{esc}[0m#{esc}[1;36mT#{esc}[0m"]
  assert render.render(th, 40, parser.parse("**b**")) == ["#{esc}[1mb#{esc}[0m"]
  assert render.render(th, 40, parser.parse("~~s~~")) == ["#{esc}[9ms#{esc}[0m"]
  assert render.render(th, 40, parser.parse("`c`")) == ["#{esc}[33mc#{esc}[0m"]
  assert render.render(th, 40, parser.parse("    f")) == ["#{esc}[33m  f#{esc}[0m"]
}

test "a centred cell splits the gap, the odd column to the right" {
  # `pad_to` has one arm per alignment, and centring is the one that has
  # to decide where an odd column goes.
  assert plain("| abcd |\n| :--: |\n| x |", 40)
    == [
      "┌──────┐",
      "│ abcd │",
      "├──────┤",
      "│  x   │",
      "└──────┘"
    ]
}

test "a label that is not plain text is shown its destination" {
  # `shows_dest` compares a single `Text` label against the destination;
  # anything else is shown the URL, since the label does not say it.
  assert plain("[*t*](https://x.example)", 60) == ["t (https://x.example)"]
  # An autolink is its own destination, so the parentheses are dropped.
  assert plain("<https://x.example>", 60) == ["https://x.example"]
}

test "an unresolved node renders as the text it still carries" {
  # `parse` settles every reference and numbers every marker, so these
  # arms only ever see an AST built by hand — which is what this builds.
  let th = theme.plain()
  assert render.render(th, 40, [ast.Para([ast.Ref([ast.Text("r")], "k")])]) == ["r"]
  assert render.render(th, 40, [ast.Para([ast.NoteRef("n")])]) == ["[^n]"]
  assert render.render(th, 40, [ast.Para([ast.ImageRef([ast.Text("i")], "k")])]) == ["i"]
}

test "a run of spaces between two words is one space" {
  # `place` is called at every space and must do nothing with no word in
  # hand, or the line would gain a column for each extra space.
  assert plain("a  b", 20) == ["a b"]
  assert plain("a     b", 20) == ["a b"]
}

test "a width under the floor is raised to it" {
  # Below `min_width` wrapping buys nothing, so what the CLI asks for is
  # raised rather than cutting the prose into fragments.
  assert render.min_width() == 20
  assert plain("one two three four five", 5) == plain("one two three four five", 20)
}

test "a hard break ends the line where the source asked, in order" {
  # The line closes with whatever is in hand, and that hand is built
  # backwards: a line that comes out reversed is the sign of it.
  assert plain("ab cd  \nef gh", 40) == ["ab cd", "ef gh"]
}

test "a table too narrow for its columns keeps a column of each" {
  # Six columns leave one of the twenty to share, so each is cut to a
  # single column rather than to none at all.
  let src =
    "| ab | cd | ef | gh | ij | kl |\n|---|---|---|---|---|---|\n| mn | op | qr | st | uv | wx |"
  let six = plain(src, 20)
  assert contains(six, "│ a │ c │ e │ g │ i │ k │")
  assert contains(six, "│ b │ d │ f │ h │ j │ l │")
  # A column with nothing in it is cut to one column too: a column of no
  # width closes the frame over itself.
  let blank =
    "| ab | cd |  | gh | ij | kl |\n|---|---|---|---|---|---|\n| mn | op |  | st | uv | wx |"
  assert contains(plain(blank, 20), "│ a │ c │   │ g │ i │ k │")
  # Seven columns leave nothing to share and the widths stand as they
  # came: a frame past the margin beats a frame with no content in it.
  let wide =
    "| ab | cd | ef | gh | ij | kl | mn |\n|---|---|---|---|---|---|---|\n| 1 | 2 | 3 | 4 | 5 | 6 | 7 |"
  assert contains(plain(wide, 20), "│ ab │ cd │ ef │ gh │ ij │ kl │ mn │")
}

test "a character wider than its column is kept, on a line of its own" {
  # The wrap lets a word wider than the margin out whole and `chop` cuts
  # it by cells; a cut that takes the whole remainder leaves no row
  # behind it.
  let src = "| a | b | c | d | e | 日 |\n|---|---|---|---|---|---|\n| 1 | 2 | 3 | 4 | 5 | 本 |"
  assert plain(src, 20)
    == [
      "┌───┬───┬───┬───┬───┬───┐",
      "│ a │ b │ c │ d │ e │ 日 │",
      "├───┼───┼───┼───┼───┼───┤",
      "│ 1 │ 2 │ 3 │ 4 │ 5 │ 本 │",
      "└───┴───┴───┴───┴───┴───┘"
    ]
  # Two of them are two lines, in the order they were written.
  let pair = "| a | b | c | d | e | 日本 |\n|---|---|---|---|---|---|\n| 1 | 2 | 3 | 4 | 5 | x |"
  assert plain(pair, 20)
    == [
      "┌───┬───┬───┬───┬───┬───┐",
      "│ a │ b │ c │ d │ e │ 日 │",
      "│   │   │   │   │   │ 本 │",
      "├───┼───┼───┼───┼───┼───┤",
      "│ 1 │ 2 │ 3 │ 4 │ 5 │ x │",
      "└───┴───┴───┴───┴───┴───┘"
    ]
}

test "a table with no body row is as wide as its header" {
  # The width of a column folds over the rows under it, and over none it
  # is nought rather than one: an empty header column stays empty.
  assert plain("|  | bb |\n|---|---|", 20)
    == [
      "┌──┬────┐", "│  │ bb │", "├──┼────┤",
      "└──┴────┘"
    ]
}

test "a container keeps a floor of four columns to write in" {
  # Nine levels of bullets leave two of the twenty, which is narrower
  # than a word: the floor is what keeps the text wrapping instead of
  # running one word per line.
  let deep =
    "- a\n  - b\n    - c\n      - d\n        - e\n          - f\n            - g\n              - h\n                - i j k l"
  assert contains(plain(deep, 20), "                • i j")
  assert contains(plain(deep, 20), "                  k l")
  # And again under a prefix wider than what is left: a heading's hashes
  # cost seven columns of the four there are.
  let under = plain("> > > > > > > > > ###### a b c d", 20)
  assert any(under, l => index_of(l, "###### a b") != None)
  assert any(under, l => index_of(l, "c d") != None)
  # A rule is drawn to the width it is handed, so it is where the floor
  # shows as a length rather than as a line break.
  assert plain("> > > > > > > > > ***", 20) == ["│ │ │ │ │ │ │ │ │ ────"]
  # And a one-column table down there has a frame that costs four of the
  # four columns: nothing left to share, so the column stands as it is
  # rather than being cut to one.
  let bar = "> > > > > > > > > "
  assert plain("#{bar}| aaa |\n#{bar}|---|\n#{bar}| b |", 20)
    == [
      "│ │ │ │ │ │ │ │ │ ┌─────┐",
      "                  │ aaa │",
      "                  ├─────┤",
      "                  │ b   │",
      "                  └─────┘"
    ]
}

test "the space between two words is painted only when both sides are" {
  # A run is not closed and reopened at every word, and where the style
  # changes the space stays neutral: painting it would carry the colour
  # one column past what the source marked.
  let esc = "\u{1b}"
  assert render.render(theme.dark(), 40, parser.parse("*a b* c"))
    == ["#{esc}[3ma b#{esc}[0m c"]
}
