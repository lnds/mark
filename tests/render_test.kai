import text
import mark.render
import mark.theme
import mark.parser
import mark.ast

# With the `plain` theme the output is layout alone: line breaking and
# indentation get checked with no codes in the way.
fn plain(src: String, width: Int) : [String] =
  render.render(theme.plain(), width, parser.parse(src))

test "a paragraph breaks between words, never inside one" {
  assert plain("one two three four five", 20) == ["one two three four", "five"]
  assert plain("supercalifragilistic ok", 20) == ["supercalifragilistic", "ok"]
}

test "a heading keeps its hashes and aligns the continuation" {
  assert plain("## A title", 40) == ["## A title"]
  let wrapped = plain("### one two three four", 20)
  assert wrapped == ["### one two three", "    four"]
}

test "blocks are separated by a blank line" {
  assert plain("one\n\ntwo", 40) == ["one", "", "two"]
}

test "code is indented and never wrapped" {
  let out = plain("```\na very long line that is left alone\n```", 20)
  assert out == ["  a very long line that is left alone"]
}

test "a quote carries its bar on every line" {
  assert plain("> hi", 40) == ["│ hi"]
}

test "lists align the continuation under the item text" {
  assert plain("- one\n- two", 40) == ["• one", "• two"]
  assert plain("1. one\n2. two", 40) == ["1. one", "2. two"]
  assert plain("10. ten", 40) == ["10. ten"]
}

test "the rule spans the requested width" {
  assert plain("---", 24) == [repeat("─", 24)]
}

test "a link shows its destination, which would otherwise be lost" {
  assert plain("[kaikai](https://kaikai-lang.org)", 60)
    == ["kaikai (https://kaikai-lang.org)"]
}

test "a table draws its frame and honours the alignments" {
  assert plain("| ab | c |\n|:--|--:|\n| 1 | 22 |", 40)
    == [
      "┌────┬────┐",
      "│ ab │  c │",
      "├────┼────┤",
      "│ 1  │ 22 │",
      "└────┴────┘"
    ]
}

test "a table is squeezed into the width rather than overflowing it" {
  # The columns want 12 and 12 plus a 7-column frame; they get 8 each.
  assert plain("| alpha | beta |\n|---|---|\n| uno dos tres | cuatro cinco |", 24)
    == [
      "┌──────────┬──────────┐",
      "│ alpha    │ beta     │",
      "├──────────┼──────────┤",
      "│ uno dos  │ cuatro   │",
      "│ tres     │ cinco    │",
      "└──────────┴──────────┘"
    ]
}

test "every line of a table is the same width, frame included" {
  let out = plain("| a | bbbbbbbbbbbbbbbbbbbb |\n|---|--:|\n| ccc | d |", 30)
  assert all(out, l => text.display_width(l) <= 30)
  # A ragged frame is the symptom of measuring text after painting it.
  assert all(out, l => text.display_width(l) == text.display_width(head_of(out)))
}

test "a word wider than its column is cut, never dropped" {
  # `wrap` lets a long word out whole rather than splitting it, which
  # would reach past the bar. In a cell it is cut, and the tail carries
  # on down: no character is lost to make the grid.
  assert plain("| x |\n|---|\n| abcdefghijklmnopqrst |", 20)
    == [
      "┌──────────────────┐",
      "│ x                │",
      "├──────────────────┤",
      "│ abcdefghijklmnop │",
      "│ qrst             │",
      "└──────────────────┘"
    ]
}

fn head_of(ls: [String]) : String = match head(ls) {
  Some(l) -> l
  None -> ""
}

test "the theme paints and closes the style" {
  let esc = "\u{1b}"
  let out = render.render(theme.dark(), 40, parser.parse("a *fact*"))
  assert out == ["a #{esc}[3mfact#{esc}[0m"]
}

fn main() : Int = 0

test "a word that exactly fills the line stays on it" {
  # `place` turns on `line.width + 1 + word.width <= width`, so the
  # boundary is the line that is exactly as wide as it may be.
  assert plain("aaaaaa bbbbbb cccccc", 20) == ["aaaaaa bbbbbb cccccc"]
  assert plain("aaaaaa bbbbbb ccccccd", 20) == ["aaaaaa bbbbbb", "ccccccd"]
}

test "a quote keeps its bar's two columns off the width it passes down" {
  # The `2` in the Quote arm is the bar: the inner block is wrapped to
  # eighteen, not to twenty.
  assert plain("> aaaaaa bbbbbb cccc", 20) == ["│ aaaaaa bbbbbb cccc"]
  assert plain("> aaaaaa bbbbbb ccccc", 20) == ["│ aaaaaa bbbbbb", "  ccccc"]
}

test "a table exactly at its budget keeps its columns, one past it gives" {
  # `fit_cols` turns on `sum(nat) <= avail`, and the frame costs seven
  # of the twenty: two columns of 7 and 6 fit exactly.
  let fits = plain("| aaaaaaa | bbbbbb |\n|---|---|\n| c | d |", 20)
  assert contains(fits, "│ aaaaaaa │ bbbbbb │")
  assert all(fits, l => text.display_width(l) == 20)
  # One column wider on each and they have to share what is left, so a
  # cell wraps rather than the table overflowing.
  let squeezed = plain("| aaaaaaaa | bbbbbbbb |\n|---|---|\n| c | d |", 20)
  assert all(squeezed, l => text.display_width(l) <= 20)
  assert contains(squeezed, "│ aa     │ bb     │")
}

test "a table with no room left to share keeps the columns it has" {
  # `fit_cols` gives up when `avail <= 0`: seven columns and their frame
  # need twenty-nine, so no sharing can make them fit in twenty. The
  # table is drawn whole rather than collapsed to nothing.
  let wide =
    plain("| a | b | c | d | e | f | g |\n|-|-|-|-|-|-|-|\n| 1 | 2 | 3 | 4 | 5 | 6 | 7 |", 20)
  assert contains(wide, "│ a │ b │ c │ d │ e │ f │ g │")
  assert all(wide, l => text.display_width(l) == 29)
}
