import mark.parser
import mark.ast

test "a realistic document: no panic, and the blocks come out in order" {
  let doc = """# Title

A paragraph spread over
several adjacent lines.

## Section

- bullet one
- bullet two
  - nested

1. first
2. second

> a quote
> over two lines

```sh
make all
```

---

The end."""
  let bs = parser.parse(doc)
  assert bs.length() == 9
  assert nth(bs, 0) == Some(Heading(1, [Text("Title")]))
  assert nth(bs, 1) == Some(Para([Text("A paragraph spread over several adjacent lines.")]))
  assert nth(bs, 2) == Some(Heading(2, [Text("Section")]))
  assert nth(bs, 5) == Some(Quote([Para([Text("a quote over two lines")])]))
  assert nth(bs, 6) == Some(Code("sh", ["make all"]))
  assert nth(bs, 7) == Some(Rule)
  assert nth(bs, 8) == Some(Para([Text("The end.")]))
}

fn main() : Int = 0
